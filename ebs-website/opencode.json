{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "stock-images-mcp": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "C:\\Users\\abdel\\.gemini\\mcp\\stock-images-mcp",
        "run",
        "--with-requirements",
        "requirements.txt",
        "server.py"
      ],
      "environment": {
        "UNSPLASH_API_KEY": "{env:UNSPLASH_API_KEY}",
        "PEXELS_API_KEY": "{env:PEXELS_API_KEY}",
        "PIXABAY_API_KEY": "{env:PIXABAY_API_KEY}"
      },
      "enabled": true
    }
  }
}
