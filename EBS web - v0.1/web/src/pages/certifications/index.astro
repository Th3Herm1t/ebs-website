---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Marker from '../../components/ui/Marker.astro';
import { allProgrammes } from '../../data/programmes';

/* Build unique certification list from all programmes */
const certMap = new Map<string, { name: string; provider: string; programmes: string[] }>();
allProgrammes.forEach(prog => {
  prog.certificationDetails.forEach(cert => {
    const key = cert.name;
    if (certMap.has(key)) {
      certMap.get(key)!.programmes.push(prog.title);
    } else {
      certMap.set(key, { name: cert.name, provider: cert.provider, programmes: [prog.title] });
    }
  });
});

/* Group by provider */
const providers = new Map<string, { name: string; provider: string; programmes: string[] }[]>();
certMap.forEach(cert => {
  if (!providers.has(cert.provider)) {
    providers.set(cert.provider, []);
  }
  providers.get(cert.provider)!.push(cert);
});

const providerOrder = ['Google', 'Salesforce', 'AWS', 'IBM', 'HubSpot', 'Cisco', 'Oracle', 'Microsoft'];
const sortedProviders = providerOrder
  .filter(p => providers.has(p))
  .map(p => ({ name: p, certs: providers.get(p)! }));

const totalCerts = certMap.size;

const title = "Catalogue Certifications — EBS Tunis";
const description = "Découvrez les certifications internationales incluses dans chaque programme EBS : AWS, Google, Salesforce, IBM, Cisco, Oracle, Microsoft, HubSpot.";

const certLogoMap: Record<string, string> = {
  'Google': '/images/certifications/google.svg',
  'Salesforce': '/images/certifications/salesforce.svg',
  'AWS': '/images/certifications/aws.svg',
  'IBM': '/images/certifications/ibm.svg',
  'HubSpot': '/images/certifications/hubspot.svg',
  'Cisco': '/images/certifications/cisco.svg',
  'Oracle': '/images/certifications/oracle.svg',
  'Microsoft': '/images/certifications/microsoft.svg',
};
---

<BaseLayout title={title} description={description}>
  <div class="w-full bg-surface text-ink antialiased">

    {/* ───────────────── HERO ───────────────── */}
    <section class="relative bg-navy overflow-hidden min-h-[55vh] flex items-center" aria-labelledby="cert-hero">
      <img src="/images/about/certifications-showcase.png" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 pb-16 md:pt-28 md:pb-20 lg:pt-36 lg:pb-24 relative z-10">
        <nav class="mb-8" aria-label="Fil d'ariane">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/" class="hover:text-accent transition-colors">Accueil</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">Certifications</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">{totalCerts} certifications · {sortedProviders.length} partenaires mondiaux</p>
          <h1 id="cert-hero" class="font-heading font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-white tracking-tight mb-5">
            Certifications internationales<Marker size="lg" class="inline-block ml-3 align-middle" />
          </h1>
          <p class="font-body text-base-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
            Chaque certification est incluse dans les frais de scolarité. Aucun coût supplémentaire. Tu passes l'examen officiel, tu obtiens un badge reconnu mondialement.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <Button href="/preinscription" variant="primary" size="lg">
              Commencer ma préinscription <span class="ml-2" aria-hidden="true">→</span>
            </Button>
            <Button href="/programmes" variant="ghost" size="lg" class="text-white/70 hover:text-accent">
              Voir les programmes
            </Button>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── TRUST STRIP ───────────────── */}
    <section class="bg-surface-alt border-b border-border/30 py-8" aria-label="Partenaires certification">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {sortedProviders.map(p => (
            <div class="flex items-center gap-2 text-ink-muted">
              <img src={certLogoMap[p.name] || ''} alt={p.name} class="w-8 h-8 object-contain grayscale hover:grayscale-0 transition-all" loading="lazy" />
              <span class="text-sm font-medium">{p.name}</span>
              <span class="text-xs text-ink-muted/60">({p.certs.length})</span>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── GUIDANCE ───────────────── */}
    <section class="py-16 lg:py-20 bg-surface reveal" aria-labelledby="guidance-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-12">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Quelle certification pour toi ?</p>
          <h2 id="guidance-heading" class="font-heading font-bold text-h3 text-ink">
            Recommandations par profil
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            { profile: 'Futur développeur', certs: 'AWS, Cisco, Oracle, Microsoft', programme: 'Licence Informatique GL', href: '/programmes/licence-informatique-genie-logiciel' },
            { profile: 'Futur marketeur digital', certs: 'Google Ads, HubSpot, Google Analytics', programme: 'Licence Marketing / Master Marketing Digital', href: '/programmes/licence-marketing' },
            { profile: 'Futur manager / chef de projet', certs: 'Google PM, Salesforce, IBM Agile', programme: 'Licence Management / Master Projets', href: '/programmes/licence-management' },
            { profile: 'Futur financier', certs: 'Oracle, Microsoft Excel, IBM Analytics', programme: 'Licence Finance / Master Ingénierie Financière', href: '/programmes/licence-finance' },
          ].map((item, i) => (
            <a href={item.href} class="group bg-surface-alt border border-border/40 p-6 hover:border-accent/30 transition-colors block reveal" style={`--delay: ${i * 60}ms`}>
              <h3 class="font-heading font-semibold text-sm text-ink mb-2 group-hover:text-accent transition-colors">{item.profile}</h3>
              <p class="text-xs text-ink-muted mb-3">Certifications clés : {item.certs}</p>
              <p class="text-xs font-semibold text-accent">{item.programme} →</p>
            </a>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── PROVIDER SECTIONS ───────────────── */}
    {sortedProviders.map((provider, pi) => (
      <section class={`py-16 lg:py-20 ${pi % 2 === 0 ? 'bg-surface' : 'bg-surface-alt'} reveal`} aria-labelledby={`provider-${provider.name.toLowerCase()}`}>
        <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
          <div class="flex items-center gap-4 mb-10">
            <img src={certLogoMap[provider.name] || ''} alt={provider.name} class="w-12 h-12 object-contain shrink-0" loading="lazy" />
            <div>
              <h2 id={`provider-${provider.name.toLowerCase()}`} class="font-heading font-bold text-h3 text-ink">
                {provider.name}
              </h2>
              <p class="text-sm text-ink-muted">{provider.certs.length} certification{provider.certs.length > 1 ? 's' : ''}</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {provider.certs.map((cert, ci) => (
              <div class="bg-surface border border-border/40 px-6 py-5 reveal" style={`--delay: ${ci * 50}ms`}>
                <p class="font-semibold text-sm text-ink mb-2">{cert.name}</p>
                <div class="flex flex-wrap gap-1.5">
                  {cert.programmes.map(prog => (
                    <span class="inline-block px-2 py-0.5 bg-navy/5 text-ink-muted text-[10px] font-medium uppercase tracking-wider">{prog}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}


    {/* ───────────────── HOW IT WORKS ───────────────── */}
    <section class="py-20 lg:py-28 bg-navy reveal" aria-labelledby="how-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Processus</p>
          <h2 id="how-heading" class="font-heading font-bold text-h2 text-white">
            Comment ça marche ?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {[
            { step: '01', title: 'Formation intégrée', desc: 'Les certifications sont intégrées au cursus. Pas de cours supplémentaires à suivre.' },
            { step: '02', title: 'Préparation guidée', desc: 'Sessions de révision, examens blancs et accès aux plateformes officielles de chaque partenaire.' },
            { step: '03', title: 'Passage officiel', desc: 'Tu passes l\'examen officiel dans les conditions réelles. Le badge obtenu est vérifiable en ligne.' },
          ].map((item, i) => (
            <div class="bg-white/[0.05] border border-white/10 p-7 reveal" style={`--delay: ${i * 80}ms`}>
              <span class="font-heading font-bold text-3xl text-accent/40 mb-4 block">{item.step}</span>
              <h3 class="font-heading font-semibold text-lg text-white mb-3">{item.title}</h3>
              <p class="text-sm text-white/50 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── CTA ───────────────── */}
    <section class="relative py-20 lg:py-28 overflow-hidden" aria-label="Inscription">
      <img src="/images/campus/students-5.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0 bg-accent/90"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 text-center relative z-10">
        <p class="text-xs font-semibold text-base-950/50 uppercase tracking-wider mb-4">{totalCerts} certifications incluses</p>
        <h2 class="font-heading font-bold text-[clamp(1.75rem,4vw,3rem)] leading-[1.1] text-base-950 mb-5">
          Ton diplôme + tes certifications<Marker size="lg" class="inline-block ml-3 align-middle bg-base-950" />
        </h2>
        <p class="font-body text-base-950/60 text-lg mb-10 max-w-md mx-auto">
          Explore les programmes et découvre quelles certifications correspondent à ton projet.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/programmes" variant="inverted" size="lg">
            Voir les programmes <span class="ml-2" aria-hidden="true">→</span>
          </Button>
          <Button href="/preinscription" variant="ghost" size="lg" class="text-base-950/70 hover:text-base-950">
            Commencer ma préinscription
          </Button>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll<HTMLElement>('.reveal');
    if (reveals.length) {
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
        }),
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      reveals.forEach((el) => obs.observe(el));
    }
  });
</script>
