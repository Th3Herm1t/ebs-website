---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Marker from '../components/ui/Marker.astro';
import VideoTour from '../components/blocks/VideoTour.astro';

const title = "À propos — EBS Tunis | Espima Business School";
const description = "Découvrez l'EBS Tunis : mission, valeurs, accréditations et campus. L'université privée où diplôme rime avec certifications internationales et emploi.";
---

<BaseLayout title={title} description={description}>
  <div class="w-full bg-surface text-ink antialiased">

    {/* ───────────────── HERO ───────────────── */}
    <section class="relative bg-navy overflow-hidden min-h-[55vh] flex items-center" aria-labelledby="about-hero">
      <img src="/images/about/groupe.png" alt="Équipe EBS Tunis" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-transparent"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 pb-16 md:pt-28 md:pb-20 lg:pt-36 lg:pb-24 relative z-10">
        <nav class="mb-8" aria-label="Fil d'ariane">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/" class="hover:text-accent transition-colors">Accueil</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">À propos</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">Depuis 2013 · Tunis, Tunisie</p>
          <h1 id="about-hero" class="font-heading font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-white tracking-tight mb-5">
            L'université qui prépare<br/>à la vraie vie<Marker size="lg" class="inline-block ml-3 align-middle" />
          </h1>
          <p class="font-body text-base-300 text-lg md:text-xl leading-relaxed max-w-2xl">
            EBS Tunis – Espima Business School – est une université privée reconnue par l'État tunisien. Notre mission : former des professionnels immédiatement opérationnels grâce à un modèle unique alliant diplôme, certifications internationales et alternance.
          </p>
        </div>
      </div>
    </section>


    {/* ───────────────── STATS ───────────────── */}
    <section class="bg-surface-alt border-b border-border/30 py-12 reveal" aria-label="Chiffres clés">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div>
            <span class="font-heading font-bold text-4xl text-accent block mb-1" data-countup="20" data-suffix="+">0</span>
            <span class="text-sm text-ink-muted font-medium">années d'expérience</span>
          </div>
          <div>
            <span class="font-heading font-bold text-4xl text-accent block mb-1" data-countup="8">0</span>
            <span class="text-sm text-ink-muted font-medium">programmes</span>
          </div>
          <div>
            <span class="font-heading font-bold text-4xl text-accent block mb-1" data-countup="27" data-suffix="+">0</span>
            <span class="text-sm text-ink-muted font-medium">certifications incluses</span>
          </div>
          <div>
            <span class="font-heading font-bold text-4xl text-accent block mb-1" data-countup="4">0</span>
            <span class="text-sm text-ink-muted font-medium">partenaires internationaux</span>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── MISSION ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="mission-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-5">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Notre mission</p>
            <h2 id="mission-heading" class="font-heading font-bold text-h2 text-ink leading-tight mb-5">
              Former pour l'emploi,<br/>pas pour le diplôme seul<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
            <div class="space-y-6 font-body text-ink-body text-base leading-relaxed">
              <p>
                Le marché de l'emploi ne demande plus seulement un diplôme. Il exige des compétences prouvées, des certifications reconnues et une expérience terrain. C'est exactement ce que l'EBS offre.
              </p>
              <p>
                Chaque programme intègre des certifications internationales (AWS, Google, Salesforce, IBM, Cisco, Oracle, Microsoft, HubSpot) directement dans le cursus. Pas en option. Pas en supplément.
              </p>
              <p>
                L'alternance commence dès la deuxième année de Licence. Nos étudiants passent 3 jours à l'EBS et 2 jours en entreprise, accumulant une expérience professionnelle concrète avant même l'obtention de leur diplôme.
              </p>
            </div>
          </div>
          <div class="lg:col-span-7">
            <div class="grid grid-cols-2 gap-3">
              <div class="relative overflow-hidden group">
                <img src="/images/events/conference-digital.jpg" alt="Conférence digitale" class="w-full h-56 object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/40 to-transparent"></div>
              </div>
              <div class="relative overflow-hidden group mt-8">
                <img src="/images/events/seminaire.jpg" alt="Séminaire EBS" class="w-full h-56 object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/40 to-transparent"></div>
              </div>
              <div class="relative overflow-hidden group col-span-2">
                <img src="/images/about/certifications-showcase.png" alt="Certifications EBS" class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/40 to-transparent"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── VALUES ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="values-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Ce qui nous définit</p>
          <h2 id="values-heading" class="font-heading font-bold text-h2 text-ink">
            Nos valeurs
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {[
            { title: 'Excellence opérationnelle', desc: 'Chaque module, chaque certification, chaque stage est conçu pour produire un professionnel prêt à contribuer dès le premier jour.', img: '/images/events/ebs-challenge.jpg' },
            { title: 'Transparence totale', desc: 'Frais clairs, certifications incluses, pas de coûts cachés. Tu sais exactement ce que tu obtiens avant de t\'inscrire.', img: '/images/campus/students-5.jpg' },
            { title: 'Ouverture internationale', desc: 'Nos partenariats avec l\'UQAT, EM Normandie et Collège de Paris ouvrent des portes au Canada et en France.', img: '/images/international/paris-student.png' },
          ].map((val, i) => (
            <div class="group bg-surface border border-border/40 overflow-hidden reveal" style={`--delay: ${i * 80}ms`}>
              <div class="relative h-48 overflow-hidden">
                <img src={val.img} alt={val.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent"></div>
              </div>
              <div class="p-7">
                <span class="w-2 h-2 bg-accent block mb-4" aria-hidden="true"></span>
                <h3 class="font-heading font-semibold text-lg text-ink mb-3">{val.title}</h3>
                <p class="text-sm text-ink-body leading-relaxed">{val.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── RECOGNITION ───────────────── */}
    <section class="relative py-20 lg:py-28 overflow-hidden reveal" aria-labelledby="recognition-heading">
      <img src="/images/campus/students-4.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0 bg-navy/92"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Reconnaissance</p>
            <h2 id="recognition-heading" class="font-heading font-bold text-h2 text-white leading-tight mb-5">
              Accréditations & reconnaissance<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-7">
            <div class="space-y-4">
              {[
                { title: 'Ministère de l\'Enseignement Supérieur', desc: 'Diplômes reconnus par l\'État tunisien. Conformité totale au système LMD.', img: '/images/partners/ministere.gif' },
                { title: 'Partenaires académiques internationaux', desc: 'Conventions avec l\'UQAT (Canada), EM Normandie, Collège de Paris et Keyce Academy (France).', img: '/images/partners/em-normandie-logo.png' },
                { title: 'Partenaires certification', desc: 'Centre de passage agréé pour AWS, Google, Salesforce, IBM, Cisco, Oracle, Microsoft et HubSpot.', img: '/images/certifications/aws.svg' },
              ].map(item => (
                <div class="bg-white/[0.05] backdrop-blur-sm border border-white/10 px-7 py-5 flex items-start gap-5">
                  <img src={item.img} alt="" class="w-10 h-10 object-contain shrink-0 mt-1" loading="lazy" />
                  <div>
                    <h3 class="font-heading font-semibold text-base text-white mb-2">{item.title}</h3>
                    <p class="text-sm text-white/50 leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── VIDEO TOUR ───────────────── */}
    <VideoTour lang="fr" />


    {/* ───────────────── CAMPUS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="campus-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Notre campus</p>
            <h2 id="campus-heading" class="font-heading font-bold text-h2 text-ink leading-tight mb-5">
              Au cœur de Tunis<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
            <div class="space-y-4 font-body text-ink-body text-base leading-relaxed mb-8">
              <p>
                Le campus EBS est situé à Tunis, facilement accessible en transport en commun. Des salles de cours modernes, des espaces de coworking et un accès aux plateformes de certification en ligne.
              </p>
              <p>
                L'environnement est conçu pour favoriser l'apprentissage collaboratif et la préparation aux certifications.
              </p>
            </div>
            {/* Photo grid */}
            <div class="grid grid-cols-3 gap-2">
              {[
                '/images/campus/campus-1.jpg',
                '/images/campus/campus-2.jpg',
                '/images/campus/students-2.jpg',
                '/images/events/salon-riyeda.jpg',
                '/images/events/forum-mobilites.jpg',
                '/images/campus/students-6.jpg',
              ].map((src, i) => (
                <div class="relative overflow-hidden group aspect-square">
                  <img src={src} alt="Campus EBS" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
                  <div class="absolute inset-0 bg-navy/20 group-hover:bg-navy/0 transition-colors duration-300"></div>
                </div>
              ))}
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="bg-surface-alt border border-border/40 p-7 mb-6">
              <h3 class="font-heading font-semibold text-base text-ink mb-4">Informations pratiques</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3 text-sm">
                  <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-2" aria-hidden="true"></span>
                  <span class="text-ink-body"><strong>Adresse :</strong> Tunis, Tunisie</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                  <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-2" aria-hidden="true"></span>
                  <span class="text-ink-body"><strong>Téléphone :</strong> +216 29 58 28 35</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                  <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-2" aria-hidden="true"></span>
                  <span class="text-ink-body"><strong>Email :</strong> admission@ebs.tn</span>
                </li>
                <li class="flex items-start gap-3 text-sm">
                  <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-2" aria-hidden="true"></span>
                  <span class="text-ink-body"><strong>Rentrée :</strong> Septembre</span>
                </li>
              </ul>
            </div>
            {/* Large campus photo */}
            <div class="relative overflow-hidden group">
              <img src="/images/about/campus-life.jpg" alt="Vie étudiante EBS" class="w-full h-64 object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/50 to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <span class="bg-accent/90 text-base-950 text-xs font-bold px-3 py-1.5">Vie étudiante</span>
              </div>
            </div>

            {/* Campus life highlights */}
            <div class="mt-6 space-y-4">
              {[
                { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>', title: 'Accompagnement individuel', desc: 'Chaque étudiant bénéficie d\'un suivi personnalisé pour son orientation et son développement professionnel.' },
                { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>', title: 'Career Center', desc: 'CV, simulations d\'entretien, mise en relation avec les entreprises partenaires et préparation aux certifications.' },
                { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>', title: 'Clubs & associations', desc: 'Club entrepreneuriat, club tech, associations sportives — la vie étudiante au-delà des cours.' },
              ].map(item => (
                <div class="flex items-start gap-3 p-4 bg-surface border border-border/30">
                  <span class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0" aria-hidden="true"><Fragment set:html={item.svg} /></span>
                  <div>
                    <h4 class="font-heading font-semibold text-sm text-ink mb-0.5">{item.title}</h4>
                    <p class="text-xs text-ink-muted leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── GOUVERNANCE ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="governance-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Gouvernance</p>
            <h2 id="governance-heading" class="font-heading font-bold text-h2 text-ink leading-tight">
              L'équipe qui pilote l'EBS<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="font-body text-ink-body text-base leading-relaxed">
              Une direction engagée, des professionnels du terrain et des académiques reconnus.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            { role: 'Direction Générale', name: 'M. le Directeur', photo: '/images/campus/campus-2.jpg', desc: 'Pilotage stratégique, partenariats internationaux et développement des programmes.' },
            { role: 'Direction Pédagogique', name: 'Responsable pédagogique', photo: '/images/events/seminaire-draoui.jpg', desc: 'Conception des parcours, intégration des certifications dans les cursus.' },
            { role: 'Direction Relations Entreprises', name: 'Responsable entreprises', photo: '/images/events/partenariat-asteelflash.jpg', desc: 'Animation du réseau de +50 entreprises partenaires, placements en alternance.' },
          ].map((person, i) => (
            <div class="group bg-surface border border-border/40 overflow-hidden hover:border-accent/30 transition-colors reveal" style={`--delay: ${i * 80}ms`}>
              <div class="relative h-48 overflow-hidden">
                <img src={person.photo} alt={person.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/70 to-transparent"></div>
                <div class="absolute bottom-3 left-4">
                  <span class="bg-accent/90 text-base-950 text-[10px] font-bold px-2.5 py-1 uppercase tracking-wider">{person.role}</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="font-heading font-semibold text-lg text-ink mb-1">{person.name}</h3>
                <p class="text-sm text-ink-body leading-relaxed">{person.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── CORPS ENSEIGNANT ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="faculty-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Corps enseignant</p>
          <h2 id="faculty-heading" class="font-heading font-bold text-h2 text-ink">
            Nos enseignants
          </h2>
          <p class="font-body text-ink-body text-base max-w-xl mx-auto mt-3">
            Un mix d'universitaires et de professionnels en activité. Chaque intervenant apporte une expertise terrain actualisée.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { domain: 'Informatique & Tech', svg: '<svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>', highlights: 'Ingénieurs certifiés AWS, Cisco, Oracle. Développeurs senior en activité dans des ESN tunisiennes.', certCount: '5+ certifiés', color: 'bg-blue-500/10' },
            { domain: 'Management & Stratégie', svg: '<svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>', highlights: 'Docteurs en sciences de gestion, consultants en transformation d\'entreprise, formateurs Salesforce.', certCount: '4+ certifiés', color: 'bg-emerald-500/10' },
            { domain: 'Marketing & Digital', svg: '<svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>', highlights: 'Experts Google Ads, HubSpot et analytics. Directeurs marketing en poste dans des entreprises nationales.', certCount: '4+ certifiés', color: 'bg-purple-500/10' },
            { domain: 'Finance & Comptabilité', svg: '<svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>', highlights: 'Experts-comptables, analystes financiers, anciens cadres bancaires. Certifiés Oracle et Microsoft.', certCount: '3+ certifiés', color: 'bg-amber-500/10' },
          ].map((dept, i) => (
            <div class="group bg-surface-alt border border-border/40 p-7 hover:border-accent/30 hover:-translate-y-1 transition-all duration-300 reveal" style={`--delay: ${i * 60}ms`}>
              <span class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4" aria-hidden="true"><Fragment set:html={dept.svg} /></span>
              <h3 class="font-heading font-semibold text-base text-ink mb-3">{dept.domain}</h3>
              <p class="text-sm text-ink-body leading-relaxed mb-4">{dept.highlights}</p>
              <span class="inline-block px-2.5 py-1 bg-accent/10 text-accent text-xs font-semibold">{dept.certCount}</span>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── SERVICES ÉTUDIANTS ───────────────── */}
    <section class="py-20 lg:py-28 bg-navy reveal" aria-labelledby="services-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Services étudiants</p>
          <h2 id="services-heading" class="font-heading font-bold text-h2 text-white">
            Tout pour réussir
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>', title: 'Career Center', desc: 'Ateliers CV, simulations d\'entretien, matching alternance, réseau employeurs. Accessible dès la L1.' },
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"/><circle cx="12" cy="8" r="7"/></svg>', title: 'Centre de certification', desc: 'Salles dédiées au passage des certifications. Accès aux plateformes officielles AWS, Google, Salesforce, etc.' },
