---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="404 — Page introuvable | EBS" description="La page que vous recherchez n'existe pas.">
  <section class="min-h-[70vh] flex items-center justify-center px-6 bg-surface">
    <div class="text-center max-w-lg">
      <span class="text-8xl font-heading font-bold text-accent">404</span>
      <h1 class="mt-4 text-2xl md:text-3xl font-heading font-bold text-ink">
        Page introuvable
      </h1>
      <p class="mt-3 text-ink-body leading-relaxed">
        La page que vous recherchez n'existe pas ou a été déplacée.
        <br />
        <span class="text-ink-muted text-sm">The page you're looking for doesn't exist or has been moved.</span>
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <Button href="/" variant="primary" size="lg">Retour à l'accueil</Button>
        <Button href="/en" variant="ghost" size="lg">Go to homepage</Button>
      </div>
    </div>
  </section>
</BaseLayout>
