---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Marker from '../components/ui/Marker.astro';

const title = "Alternance — EBS Tunis";
const description = "L'alternance dès la L2 à l'EBS Tunis : 3 jours cours, 2 jours entreprise. Découvrez notre modèle unique d'immersion professionnelle.";
---

<BaseLayout title={title} description={description}>
  <div class="w-full bg-surface text-ink antialiased">

    {/* ───────────────── HERO ───────────────── */}
    <section class="relative bg-navy overflow-hidden min-h-[55vh] flex items-center" aria-labelledby="alt-hero">
      <img src="/images/events/visite-dot.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 pb-16 md:pt-28 md:pb-20 lg:pt-36 lg:pb-24 relative z-10">
        <nav class="mb-8" aria-label="Fil d'ariane">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/" class="hover:text-accent transition-colors">Accueil</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">Alternance</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">Dès la L2 · 3j EBS / 2j entreprise</p>
          <h1 id="alt-hero" class="font-heading font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-white tracking-tight mb-5">
            L'alternance qui change<br/>la donne<Marker size="lg" class="inline-block ml-3 align-middle" />
          </h1>
          <p class="font-body text-base-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
            Pendant que d'autres accumulent de la théorie, nos étudiants accumulent de l'expérience. L'alternance EBS commence dès la deuxième année de Licence.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <Button href="/preinscription" variant="primary" size="lg">
              Commencer ma préinscription <span class="ml-2" aria-hidden="true">→</span>
            </Button>
            <Button href="/programmes" variant="ghost" size="lg" class="text-white/70 hover:text-accent">
              Voir les programmes
            </Button>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── SCHEDULE ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="schedule-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Rythme hebdomadaire</p>
          <h2 id="schedule-heading" class="font-heading font-bold text-h2 text-ink">
            Ta semaine type
          </h2>
        </div>

        <div class="max-w-3xl mx-auto">
          <div class="grid grid-cols-5 gap-2 mb-6">
            {['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'].map((day, i) => (
              <div class={`p-4 text-center ${i < 3 ? 'bg-navy text-white' : 'bg-accent text-base-950'}`}>
                <span class="font-heading font-bold text-sm block mb-1">{day}</span>
                <span class={`text-xs font-medium ${i < 3 ? 'text-white/60' : 'text-base-950/60'}`}>
                  {i < 3 ? 'EBS' : 'Entreprise'}
                </span>
              </div>
            ))}
          </div>
          <div class="flex items-center justify-center gap-6 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-4 h-3 bg-navy" aria-hidden="true"></span>
              <span class="text-ink-muted">Cours à l'EBS</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-4 h-3 bg-accent" aria-hidden="true"></span>
              <span class="text-ink-muted">En entreprise</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── BENEFITS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="benefits-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Pourquoi l'alternance ?</p>
            <h2 id="benefits-heading" class="font-heading font-bold text-h2 text-ink leading-tight">
              Les avantages concrets<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="font-body text-ink-body text-base leading-relaxed">
              L'alternance n'est pas un bonus. C'est le cœur de la pédagogie EBS.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
            {[
              { title: 'Expérience dès la L2', desc: 'Pas besoin d\'attendre le diplôme pour commencer à travailler. L\'immersion professionnelle commence en deuxième année.' },
              { title: 'CV renforcé', desc: 'À la sortie, tu as déjà 2 à 3 ans d\'expérience professionnelle en plus de ton diplôme et de tes certifications.' },
              { title: 'Réseau professionnel', desc: 'Tu construis ton réseau dans l\'entreprise d\'accueil, ce qui facilite l\'embauche après le diplôme.' },
              { title: 'Compétences appliquées', desc: 'La théorie vue en cours le lundi est mise en pratique en entreprise le jeudi. Apprentissage accéléré.' },
              { title: 'Rémunération', desc: 'En alternance, tu bénéficies d\'une rémunération ou indemnité de la part de l\'entreprise d\'accueil.' },
              { title: 'Taux d\'emploi élevé', desc: '68% de nos alternants sont embauchés dans leur entreprise d\'accueil avant même l\'obtention du diplôme.' },
            ].map((benefit, i) => (
              <div class="bg-surface-alt border border-border/40 p-7 reveal" style={`--delay: ${i * 60}ms`}>
                <span class="w-2 h-2 bg-accent block mb-5" aria-hidden="true"></span>
                <h3 class="font-heading font-semibold text-base text-ink mb-3">{benefit.title}</h3>
                <p class="text-sm text-ink-body leading-relaxed">{benefit.desc}</p>
              </div>
            ))}
          </div>
          <div class="hidden lg:grid grid-rows-2 gap-6">
            <div class="relative overflow-hidden group">
              <img src="/images/events/partenariat-asteelflash.jpg" alt="Partenariat entreprise" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/50 to-transparent"></div>
            </div>
            <div class="relative overflow-hidden group">
              <img src="/images/events/visite-dabchy.jpg" alt="Visite entreprise" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-navy/50 to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── TIMELINE ───────────────── */}
    <section class="py-20 lg:py-28 bg-navy reveal" aria-labelledby="timeline-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Parcours</p>
          <h2 id="timeline-heading" class="font-heading font-bold text-h2 text-white">
            Quand commence l'alternance ?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {[
            { year: 'L1', title: 'Fondamentaux', desc: 'Première année dédiée aux bases théoriques et méthodologiques. Pas encore d\'alternance.', active: false },
            { year: 'L2-L3', title: 'Alternance active', desc: 'Début de l\'alternance : 3 jours EBS, 2 jours entreprise. Stage long en continu.', active: true },
            { year: 'M1-M2', title: 'Expertise + alternance', desc: 'L\'alternance se poursuit en Master avec des missions de plus en plus stratégiques.', active: true },
          ].map((step, i) => (
            <div class={`p-7 border ${step.active ? 'bg-accent/10 border-accent/30' : 'bg-white/[0.03] border-white/10'} reveal`} style={`--delay: ${i * 80}ms`}>
              <span class={`font-heading font-bold text-2xl block mb-3 ${step.active ? 'text-accent' : 'text-white/40'}`}>{step.year}</span>
              <h3 class="font-heading font-semibold text-base text-white mb-2">{step.title}</h3>
              <p class="text-sm text-white/50 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── PLACEMENT & ACCOMPAGNEMENT ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="placement-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Accompagnement placement</p>
            <h2 id="placement-heading" class="font-heading font-bold text-h2 text-ink leading-tight">
              Comment on te trouve une alternance<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="font-body text-ink-body text-base leading-relaxed">
              Tu n'es pas seul dans ta recherche. Le Career Center EBS mobilise son réseau pour chaque étudiant.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
          {[
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>', title: 'Réseau entreprises', desc: 'EBS entretient des conventions avec plus de 50 entreprises partenaires qui accueillent nos alternants chaque année.' },
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>', title: 'Coaching CV & entretien', desc: 'Ateliers de préparation : rédaction de CV, simulation d\'entretien, personal branding. Dès la L1.' },
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>', title: 'Matching personnalisé', desc: 'Le Career Center croise ton profil, ta filière et tes aspirations avec les offres de nos partenaires.' },
            { svg: '<svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>', title: 'Suivi continu', desc: 'Un tuteur EBS suit ta progression en entreprise. Point trimestriel avec ton encadrant professionnel.' },
          ].map((item, i) => (
            <div class="bg-surface-alt border border-border/40 p-7 reveal" style={`--delay: ${i * 60}ms`}>
              <span class="w-10 h-10 bg-accent/10 flex items-center justify-center mb-4" aria-hidden="true"><Fragment set:html={item.svg} /></span>
              <h3 class="font-heading font-semibold text-base text-ink mb-3">{item.title}</h3>
              <p class="text-sm text-ink-body leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        {/* Recruiting companies strip */}
        <div class="bg-surface-alt border border-border/40 p-8">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">Ils recrutent nos alternants</p>
          <div class="flex flex-wrap gap-3">
            {[
              'Vermeg', 'Sofrecom', 'Telnet', 'Orange Tunisie', 'Think IT', 'Linedata',
              'Biat', 'Amen Bank', 'BH Bank', 'Tunisair', 'Poulina Group',
              'MG Tunisie', 'Jumia', 'Carrefour Tunisie', 'Capgemini', 'Berexia',
              'Talan', 'CGI', 'Salesforce EMEA', 'Deloitte Tunisie',
            ].map(company => (
              <span class="inline-block px-3 py-1.5 bg-surface text-ink-body text-sm font-medium border border-border/30">{company}</span>
            ))}
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── FILET DE SÉCURITÉ ───────────────── */}
    <section class="bg-accent/5 border-y border-accent/10 reveal" aria-label="Si tu ne trouves pas d'alternance">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-8">
            <h3 class="font-heading font-semibold text-lg text-ink mb-3">Et si je ne trouve pas d'alternance ?</h3>
            <p class="text-sm text-ink-body leading-relaxed mb-4">
              Pas de panique. Le Career Center intensifie l'accompagnement : entretiens individuels, nouvelles propositions de notre réseau, et si nécessaire, un stage conventionné en remplacement. <strong class="text-ink">Aucun étudiant n'est laissé sans solution.</strong>
            </p>
            <p class="text-sm text-ink-body leading-relaxed">
              En dernier recours, le format passe en stage long (2 à 4 mois) intégré au semestre, validant les mêmes compétences professionnelles.
            </p>
          </div>
          <div class="md:col-span-4 text-center md:text-right">
            <span class="font-heading font-bold text-4xl text-accent block mb-1" data-countup="96" data-suffix="%">0</span>
            <span class="text-sm text-ink-muted">de nos étudiants trouvent<br/>leur alternance via EBS</span>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── CTA ───────────────── */}
    <section class="relative py-20 lg:py-28 overflow-hidden" aria-label="Inscription">
      <img src="/images/campus/students-7.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0 bg-accent/90"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 text-center relative z-10">
        <p class="text-xs font-semibold text-base-950/50 uppercase tracking-wider mb-4">Alternance dès la L2</p>
        <h2 class="font-heading font-bold text-[clamp(1.75rem,4vw,3rem)] leading-[1.1] text-base-950 mb-5">
          Apprends en travaillant<Marker size="lg" class="inline-block ml-3 align-middle bg-base-950" />
        </h2>
        <p class="font-body text-base-950/60 text-lg mb-10 max-w-md mx-auto">
          Explore les programmes en alternance et commence ta préinscription.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/preinscription" variant="inverted" size="lg">
            Commencer ma préinscription <span class="ml-2" aria-hidden="true">→</span>
          </Button>
          <Button href="/programmes" variant="ghost" size="lg" class="text-base-950/70 hover:text-base-950">
            Voir les programmes
          </Button>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll<HTMLElement>('.reveal');
    if (reveals.length) {
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
        }),
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      reveals.forEach((el) => obs.observe(el));
    }
  });
</script>
