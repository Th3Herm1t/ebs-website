---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Marker from '../components/ui/Marker.astro';
import ROICalculator from '../components/blocks/ROICalculator.astro';

const title = "Admissions — EBS Tunis | Guide complet";
const description = "Tout savoir sur les admissions à l'EBS Tunis : conditions d'accès, étapes, calendrier et documents requis pour Licence et Master.";

const steps = [
  {
    num: '01',
    title: 'Préinscription en ligne',
    description: 'Remplis le formulaire en 3 minutes avec tes informations personnelles et ton choix de programme.',
    svg: '<svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>',
  },
  {
    num: '02',
    title: 'Étude du dossier',
    description: 'Notre équipe examine ton dossier sous 48h. Aucun concours d\'entrée — l\'admission est basée sur ton parcours.',
    svg: '<svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"/></svg>',
  },
  {
    num: '03',
    title: 'Entretien de motivation',
    description: 'Un échange de 20 minutes pour comprendre ton projet professionnel et répondre à toutes tes questions.',
    svg: '<svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>',
  },
  {
    num: '04',
    title: 'Confirmation d\'inscription',
    description: 'Tu reçois ta lettre d\'admission et finalises ton inscription avec les documents officiels.',
    svg: '<svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
  },
];

const requirementsLicence = [
  'Baccalauréat (toutes sections)',
  'Relevé de notes du bac',
  'Copie de la carte d\'identité nationale',
  'Photo d\'identité récente',
  '2 enveloppes timbrées',
];

const requirementsMaster = [
  'Licence ou diplôme équivalent (Bac+3)',
  'Relevés de notes des 3 années de licence',
  'Copie du diplôme de licence',
  'Copie de la carte d\'identité nationale',
  'CV actualisé',
  'Lettre de motivation',
  'Photo d\'identité récente',
];

const faq = [
  { q: 'Y a-t-il un concours d\'entrée ?', a: 'Non. L\'admission à l\'EBS se fait sur dossier et entretien de motivation. Pas de concours, pas de stress inutile.' },
  { q: 'Quand ouvrent les inscriptions ?', a: 'Les inscriptions ouvrent chaque année en mai et restent ouvertes jusqu\'à fin septembre, sous réserve de places disponibles.' },
  { q: 'Peut-on s\'inscrire en cours d\'année ?', a: 'Les inscriptions en cours d\'année sont possibles sous conditions. Contacte notre équipe pour étudier ta situation.' },
  { q: 'L\'EBS est-elle reconnue par l\'État ?', a: 'Oui, l\'EBS Tunis est une université privée reconnue par le Ministère de l\'Enseignement Supérieur tunisien. Nos diplômes sont conformes au système LMD.' },
  { q: 'Quel est le coût de la scolarité ?', a: 'Les frais varient selon le programme : à partir de 6 000 DT/an pour la Licence Informatique, 8 200 DT/an pour les autres Licences, et 8 500 DT/an pour les Masters. Les 27+ certifications sont incluses.' },
  { q: 'Des facilités de paiement sont-elles disponibles ?', a: 'Oui, le paiement peut être échelonné en plusieurs tranches. Contacte notre service financier pour un plan personnalisé.' },
];
---

<BaseLayout title={title} description={description}>
  <div class="w-full bg-surface text-ink antialiased">

    {/* ───────────────── HERO ───────────────── */}
    <section class="relative bg-navy overflow-hidden min-h-[55vh] flex items-center" aria-labelledby="admissions-hero">
      <img src="/images/campus/students-1.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 pb-16 md:pt-28 md:pb-20 lg:pt-36 lg:pb-24 relative z-10">
        <nav class="mb-8" aria-label="Fil d'ariane">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/" class="hover:text-accent transition-colors">Accueil</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">Admissions</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">Sur dossier · Sans concours</p>
          <h1 id="admissions-hero" class="font-heading font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-white tracking-tight mb-5">
            Ton admission,<br/>étape par étape<Marker size="lg" class="inline-block ml-3 align-middle" />
          </h1>
          <p class="font-body text-base-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
            Pas de concours, pas de surprise. L'admission à l'EBS repose sur ton parcours et ta motivation. Voici tout ce que tu dois savoir.
          </p>
          <Button href="/preinscription" variant="primary" size="lg">
            Commencer ma préinscription <span class="ml-2" aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </section>


    {/* ───────────────── STEPS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="steps-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Processus simplifié</p>
          <h2 id="steps-heading" class="font-heading font-bold text-h2 text-ink">
            4 étapes vers ton inscription
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map((step) => (
            <div class="relative bg-surface-alt border border-border/30 p-8 group reveal">
              <span class="w-12 h-12 bg-accent/10 flex items-center justify-center mb-4" aria-hidden="true"><Fragment set:html={step.svg} /></span>
              <span class="font-heading font-bold text-accent text-sm mb-2 block">{step.num}</span>
              <h3 class="font-heading font-bold text-lg text-ink mb-3">{step.title}</h3>
              <p class="font-body text-ink-muted text-sm leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ───────────────── CAMPUS PHOTO STRIP ───────────────── */}
    <section class="bg-surface-alt border-y border-border/30 py-0" aria-label="Photos campus">
      <div class="grid grid-cols-2 md:grid-cols-4 h-48 md:h-56">
        {['/images/campus/campus-1.jpg', '/images/events/conference.jpg', '/images/campus/students-10.jpg', '/images/events/it-business-expo.jpg'].map((src) => (
          <div class="relative overflow-hidden group">
            <img src={src} alt="Campus EBS" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-navy/10 group-hover:bg-navy/0 transition-colors"></div>
          </div>
        ))}
      </div>
    </section>


    {/* ───────────────── REQUIREMENTS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="requirements-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Dossier d'admission</p>
          <h2 id="requirements-heading" class="font-heading font-bold text-h2 text-ink">
            Documents requis
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl mx-auto">
          {/* Licence */}
          <div class="bg-surface border border-border/30 p-8">
            <div class="flex items-center gap-3 mb-6">
              <span class="bg-navy text-white text-xs font-bold px-3 py-1 uppercase tracking-wider">Licence</span>
              <span class="text-sm text-ink-muted">Bac requis</span>
            </div>
            <ul class="space-y-3">
              {requirementsLicence.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="text-accent font-bold mt-0.5">✓</span>
                  <span class="font-body text-sm text-ink">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Master */}
          <div class="bg-surface border border-border/30 p-8">
            <div class="flex items-center gap-3 mb-6">
              <span class="bg-accent text-base-950 text-xs font-bold px-3 py-1 uppercase tracking-wider">Master</span>
              <span class="text-sm text-ink-muted">Bac+3 requis</span>
            </div>
            <ul class="space-y-3">
              {requirementsMaster.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="text-accent font-bold mt-0.5">✓</span>
                  <span class="font-body text-sm text-ink">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── FINANCING & PAYMENT ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="financing-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Financement & Tarifs</p>
            <h2 id="financing-heading" class="font-heading font-bold text-h2 text-ink leading-tight">
              Tout est transparent<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="font-body text-ink-body text-base leading-relaxed">
              Les frais de scolarité incluent toutes les certifications internationales. Aucun coût caché.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <div class="bg-surface-alt border border-border/40 p-7">
            <p class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3">Licence Informatique</p>
            <span class="font-heading font-bold text-3xl text-accent" data-countup="6000" data-sep=" ">0</span>
            <span class="text-ink-muted text-sm ml-1">DT/an</span>
            <p class="text-xs text-ink-muted mt-2">14 certifications incluses</p>
          </div>
          <div class="bg-surface-alt border border-border/40 p-7">
            <p class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3">Autres Licences</p>
            <span class="font-heading font-bold text-3xl text-accent" data-countup="8200" data-sep=" ">0</span>
            <span class="text-ink-muted text-sm ml-1">DT/an</span>
            <p class="text-xs text-ink-muted mt-2">10 certifications incluses</p>
          </div>
          <div class="bg-surface-alt border border-border/40 p-7">
            <p class="text-xs font-bold uppercase tracking-wider text-ink-muted mb-3">Masters</p>
            <span class="font-heading font-bold text-3xl text-accent" data-countup="8500" data-sep=" ">0</span>
            <span class="text-ink-muted text-sm ml-1">DT/an</span>
            <p class="text-xs text-ink-muted mt-2">4 à 8 certifications incluses</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Payment plans */}
          <div class="bg-surface-alt border border-border/40 p-7">
            <h3 class="font-heading font-semibold text-base text-ink mb-4">Facilités de paiement</h3>
            <ul class="space-y-3">
              {[
                'Paiement en 3 tranches (inscription + 2 versements trimestriels)',
                'Paiement en 4 tranches sur demande (inscription + 3 versements)',
                'Frais d\'inscription : 1 500 DT à la confirmation (déduits du total)',
                'Réduction fratrie : -10% pour le 2ème enfant inscrit à l\'EBS',
              ].map(item => (
                <li class="flex items-start gap-3 text-sm text-ink-body">
                  <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-2" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          {/* Counselor contact */}
          <div class="bg-accent/5 border border-accent/15 p-7">
            <h3 class="font-heading font-semibold text-base text-ink mb-4">Conseillère admission</h3>
            <p class="text-sm text-ink-body leading-relaxed mb-4">
              Pour toute question sur les tarifs, les facilités de paiement ou ton dossier, contacte directement notre équipe.
            </p>
            <div class="space-y-2">
              <div class="flex items-center gap-3 text-sm">
                <span class="text-accent" aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                <a href="tel:+21629582835" class="text-ink hover:text-accent transition-colors font-medium">+216 29 58 28 35</a>
              </div>
              <div class="flex items-center gap-3 text-sm">
                <span class="text-accent" aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
                <a href="mailto:admission@ebs.tn" class="text-ink hover:text-accent transition-colors font-medium">admission@ebs.tn</a>
              </div>
              <div class="flex items-center gap-3 text-sm">
                <span class="text-accent" aria-hidden="true"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                <a href="https://wa.me/21629582835" target="_blank" rel="noopener noreferrer" class="text-ink hover:text-accent transition-colors font-medium">WhatsApp</a>
              </div>
              <p class="text-xs text-ink-muted mt-3">Disponible du lundi au vendredi, 9h–17h.</p>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── INTAKE INFO ───────────────── */}
    <section class="bg-navy reveal" aria-label="Rentrées et places">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div>
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-2">Rentrée principale</span>
            <span class="font-heading font-bold text-3xl text-white">Octobre 2025</span>
            <p class="text-sm text-white/50 mt-1">Début des cours : 1ère semaine d'octobre</p>
          </div>
          <div>
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-2">Places disponibles</span>
            <span class="font-heading font-bold text-3xl text-white">~30 places/filière</span>
            <p class="text-sm text-white/50 mt-1">Licences & Masters. Inscriptions par ordre d'arrivée.</p>
          </div>
          <div>
            <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-2">Date limite</span>
            <span class="font-heading font-bold text-3xl text-white">30 Sept. 2025</span>
            <p class="text-sm text-white/50 mt-1">Clôture inscriptions (sous réserve de places)</p>
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── CALENDAR ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="calendar-heading">
      <div class="max-w-5xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Calendrier</p>
          <h2 id="calendar-heading" class="font-heading font-bold text-h2 text-ink">
            Dates clés
          </h2>
        </div>

        <div class="relative">
          {/* Timeline line */}
          <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-px bg-border/50 hidden md:block" aria-hidden="true"></div>

          <div class="space-y-8 md:space-y-12">
            {[
              { period: 'Mai – Juin', label: 'Ouverture des inscriptions', detail: 'Préinscription en ligne ouverte. Premiers dossiers traités en priorité.' },
              { period: 'Juillet – Août', label: 'Entretiens de motivation', detail: 'Sessions d\'entretien hebdomadaires. Résultats communiqués sous 48h.' },
              { period: 'Septembre', label: 'Dernières places', detail: 'Inscriptions tardives acceptées sous réserve de disponibilité.' },
              { period: 'Octobre', label: 'Rentrée universitaire', detail: 'Début des cours. Semaine d\'intégration et présentation des certifications.' },
            ].map((event, i) => (
              <div class={`md:grid md:grid-cols-2 md:gap-12 items-center ${i % 2 === 1 ? 'md:direction-rtl' : ''}`}>
                <div class={`${i % 2 === 1 ? 'md:text-right md:col-start-2' : 'md:col-start-1'}`}>
                  <span class="inline-block bg-accent/10 text-accent text-xs font-bold px-3 py-1 mb-2">{event.period}</span>
                  <h3 class="font-heading font-bold text-lg text-ink mb-2">{event.label}</h3>
                  <p class="font-body text-sm text-ink-muted leading-relaxed">{event.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>


    {/* ───────────────── ROI CALCULATOR ───────────────── */}
    <ROICalculator lang="fr" />


    {/* ───────────────── FAQ ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="faq-heading">
      <div class="max-w-3xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Questions fréquentes</p>
          <h2 id="faq-heading" class="font-heading font-bold text-h2 text-ink">
            FAQ Admissions
          </h2>
        </div>

        <div class="space-y-4">
          {faq.map((item) => (
            <details class="group bg-surface border border-border/30 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-ink hover:text-accent transition-colors">
                <span>{item.q}</span>
                <span class="ml-4 text-accent transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
              </summary>
              <div class="px-6 pb-6 pt-0">
                <p class="font-body text-sm text-ink-muted leading-relaxed">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── CTA ───────────────── */}
    <section class="relative bg-accent overflow-hidden" aria-labelledby="admissions-cta">
      <img src="/images/campus/students-8.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0 bg-accent/90"></div>
      <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-20 py-20 lg:py-28 text-center relative z-10">
        <h2 id="admissions-cta" class="font-heading font-bold text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.1] text-base-950 mb-4">
          Prêt à rejoindre l'EBS ?
        </h2>
        <p class="font-body text-base-950/70 text-lg mb-8 max-w-lg mx-auto">
          Préinscription en ligne en 3 minutes. Notre équipe te recontacte sous 48h.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/preinscription" variant="inverted" size="lg">
            Commencer ma préinscription <span class="ml-2" aria-hidden="true">→</span>
          </Button>
          <Button href="/programmes" variant="ghost" size="lg" class="text-base-950/70 hover:text-base-950">
            Explorer les programmes
          </Button>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    reveals.forEach((el) => io.observe(el));
  });
</script>
