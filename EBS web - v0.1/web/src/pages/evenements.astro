---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marker from '../components/ui/Marker.astro';
import Button from '../components/ui/Button.astro';

const title = "Événements & Agenda — EBS Tunis";
const description = "Journées portes ouvertes, webinaires, sessions de certification et événements étudiants à EBS Tunis.";

const upcomingEvents = [
  {
    date: '10 Mai 2026',
    day: '10',
    month: 'MAI',
    type: 'Portes Ouvertes',
    title: 'Journée Portes Ouvertes',
    desc: 'Découvrez notre campus, rencontrez les enseignants et assistez à des démonstrations de nos programmes.',
    time: '09:00 – 16:00',
    location: 'Campus EBS, Les Berges du Lac, Tunis',
    cta: '/preinscription',
    highlight: true,
  },
  {
    date: '22 Mai 2026',
    day: '22',
    month: 'MAI',
    type: 'Webinaire',
    title: 'Webinaire : Alternance — Comment ça marche ?',
    desc: 'Session en ligne pour comprendre le fonctionnement de l\'alternance, les entreprises partenaires et les retours d\'expérience.',
    time: '18:00 – 19:30',
    location: 'En ligne (Zoom)',
    cta: '#',
    highlight: false,
  },
  {
    date: '5 Juin 2026',
    day: '05',
    month: 'JUI',
    type: 'Certification',
    title: 'Session de certification AWS Cloud Practitioner',
    desc: 'Passage officiel de la certification AWS pour les étudiants de L2 et L3 Informatique.',
    time: '10:00 – 12:00',
    location: 'Campus EBS, Salle 201',
    cta: '#',
    highlight: false,
  },
  {
    date: '15 Juin 2026',
    day: '15',
    month: 'JUI',
    type: 'Conférence',
    title: 'Conférence : L\'IA dans le marketing en 2026',
    desc: 'Intervenant invité de Google Tunisia. Tendances IA, outils et perspectives de carrière.',
    time: '14:00 – 16:00',
    location: 'Campus EBS, Amphithéâtre',
    cta: '#',
    highlight: false,
  },
  {
    date: '28 Juin 2026',
    day: '28',
    month: 'JUI',
    type: 'Portes Ouvertes',
    title: 'Portes Ouvertes Spéciale Masters',
    desc: 'Session dédiée aux programmes Master. Présentation des parcours, rentrée de septembre et partenariats internationaux.',
    time: '10:00 – 14:00',
    location: 'Campus EBS, Les Berges du Lac, Tunis',
    cta: '/preinscription',
    highlight: true,
  },
  {
    date: '10 Juillet 2026',
    day: '10',
    month: 'JUL',
    type: 'Séminaire',
    title: 'Séminaire Salesforce : CRM & Transformation Digitale',
    desc: 'Workshop pratique animé par un consultant Salesforce certifié. Ouvert aux étudiants L3 et Master.',
    time: '09:00 – 12:00',
    location: 'Campus EBS, Lab Digital',
    cta: '#',
    highlight: false,
  },
];

const typeColors: Record<string, string> = {
  'Portes Ouvertes': 'bg-accent text-base-950',
  'Webinaire': 'bg-blue-600 text-white',
  'Certification': 'bg-emerald-600 text-white',
  'Conférence': 'bg-purple-600 text-white',
  'Séminaire': 'bg-amber-600 text-base-950',
};
---

<BaseLayout title={title} description={description}>
  <div class="w-full bg-surface text-ink antialiased">

    {/* Hero */}
    <section class="relative bg-navy overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="/images/events/conference-digital.jpg" alt="" class="w-full h-full object-cover opacity-20" loading="eager" />
        <div class="absolute inset-0 bg-navy/80"></div>
      </div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-24 pb-16 md:pt-32 md:pb-20 relative z-10">
        <nav class="mb-8" aria-label="Fil d'ariane">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/" class="hover:text-accent transition-colors">Accueil</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">Événements</li>
          </ol>
        </nav>
        <h1 class="font-heading font-bold text-[clamp(2rem,4vw,3rem)] text-white leading-tight mb-4">
          Événements & Agenda<Marker size="lg" class="inline-block ml-3 align-middle" />
        </h1>
        <p class="font-body text-white/60 text-lg max-w-xl">
          Portes ouvertes, webinaires, sessions de certification et conférences.
        </p>
      </div>
    </section>

    {/* Events list */}
    <section class="py-16 lg:py-24">
      <div class="max-w-5xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="space-y-6">
          {upcomingEvents.map((event, i) => (
            <div class:list={[
              'group flex flex-col md:flex-row gap-6 border overflow-hidden transition-all hover:border-accent/30 reveal',
              event.highlight ? 'border-accent/30 bg-accent/5' : 'border-border/40 bg-surface',
            ]} style={`--delay: ${i * 60}ms`}>
              {/* Date badge */}
              <div class="flex-shrink-0 w-full md:w-24 bg-navy flex flex-row md:flex-col items-center justify-center gap-2 md:gap-0 p-4 md:p-6">
                <span class="font-heading font-black text-3xl md:text-4xl text-white">{event.day}</span>
                <span class="font-heading font-bold text-xs text-accent uppercase tracking-wider">{event.month}</span>
              </div>

              {/* Content */}
              <div class="flex-1 p-6 md:py-6 md:px-2">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span class={`px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${typeColors[event.type] || 'bg-ink-muted text-white'}`}>{event.type}</span>
                  <span class="text-xs text-ink-muted">{event.time}</span>
                </div>
                <h2 class="font-heading font-bold text-lg text-ink mb-2 group-hover:text-accent transition-colors">{event.title}</h2>
                <p class="text-sm text-ink-body leading-relaxed mb-3">{event.desc}</p>
                <div class="flex items-center gap-2 text-xs text-ink-muted">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  {event.location}
                </div>
              </div>

              {/* CTA */}
              <div class="flex-shrink-0 flex items-center p-6">
                {event.highlight ? (
                  <Button href={event.cta} variant="primary" size="sm">
                    S'inscrire <span class="ml-1">→</span>
                  </Button>
                ) : (
                  <span class="text-xs font-semibold text-ink-muted group-hover:text-accent transition-colors">Détails →</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
