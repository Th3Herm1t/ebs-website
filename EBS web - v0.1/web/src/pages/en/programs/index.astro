<style>
  .prog-grid-bg {
    background-image: radial-gradient(var(--color-accent) 1.5px, transparent 1.5px);
    background-size: 24px 24px;
    animation: grid-breathe 8s ease-in-out infinite;
  }

  @keyframes grid-breathe {
    0%, 100% { opacity: 0.04; }
    50% { opacity: 0.08; }
  }

  /* Scroll-triggered reveal */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .prog-card {
    animation: none; /* Controlled by IntersectionObserver now */
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s ease;
  }
  .prog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(6, 57, 102, 0.08);
  }

  .hero-panels > * {
    animation: panel-slide 0.5s var(--ease-out-expo) both;
  }
  .hero-panels > :nth-child(1) { animation-delay: 200ms; }
  .hero-panels > :nth-child(2) { animation-delay: 320ms; }

  @keyframes panel-slide {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .journey-bar {
    scrollbar-width: none;
  }
  .journey-bar::-webkit-scrollbar {
    display: none;
  }

  /* Career chevron rotation */
  .careers-block.is-open .careers-chevron {
    transform: rotate(180deg);
  }

  /* Journey tooltip active */
  .journey-tooltip.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .prog-grid-bg { animation: none; opacity: 0.04; }
    .reveal { opacity: 1; transform: none; transition: none; }
    .prog-card { transition: none; }
    .prog-card:hover { transform: none; }
    .hero-panels > * { animation: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    /* ── Scroll reveal (IntersectionObserver) ── */
    const reveals = document.querySelectorAll<HTMLElement>('.reveal');
    if (reveals.length) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              /* Stagger children if it's a grid of cards */
              const cards = entry.target.querySelectorAll<HTMLElement>('.prog-card');
              if (cards.length) {
                cards.forEach((card, i) => {
                  setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                  }, i * 80);
                });
              }
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      reveals.forEach((el) => {
        /* Set initial state for child cards */
        el.querySelectorAll<HTMLElement>('.prog-card').forEach((card) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(16px)';
          card.style.transition = 'opacity 0.5s var(--ease-out-expo), transform 0.5s var(--ease-out-expo)';
        });
        revealObserver.observe(el);
      });
    }



    /* ── Expandable career chips ── */
    document.querySelectorAll<HTMLElement>('.careers-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const block = btn.closest('.careers-block');
        const list = block?.querySelector<HTMLElement>('.careers-list');
        if (!block || !list) return;
        const isOpen = block.classList.toggle('is-open');
        if (isOpen) {
          list.style.maxHeight = list.scrollHeight + 'px';
        } else {
          list.style.maxHeight = '0';
        }
      });
    });

    /* ── Journey timeline hover tooltip ── */
    const tooltip = document.querySelector<HTMLElement>('.journey-tooltip');
    const tooltipText = document.querySelector<HTMLElement>('.journey-tooltip-text');
    document.querySelectorAll<HTMLButtonElement>('.journey-step').forEach((step) => {
      step.addEventListener('mouseenter', () => {
        if (tooltip && tooltipText) {
          tooltipText.textContent = step.dataset.detail || '';
          tooltip.classList.add('is-active');
        }
      });
      step.addEventListener('mouseleave', () => {
        tooltip?.classList.remove('is-active');
      });
      /* Touch support */
      step.addEventListener('click', () => {
        if (tooltip && tooltipText) {
          tooltipText.textContent = step.dataset.detail || '';
          tooltip.classList.add('is-active');
          setTimeout(() => tooltip.classList.remove('is-active'), 2500);
        }
      });
    });
  });
</script>
