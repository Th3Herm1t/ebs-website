---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import Marker from '../../components/ui/Marker.astro';
import { flags } from '../../data/programmes';
import AlumniMap from '../../components/blocks/AlumniMap.astro';

const partners = [
  {
    name: 'UQAT',
    fullName: 'Université du Québec en Abitibi-Témiscamingue',
    country: 'Canada',
    flag: 'CA',
    description: 'Recognized Canadian public university. Dual degree available for students in Management, Marketing and Finance.',
    programmes: ['Management', 'Marketing', 'Finance'],
    advantages: ['Tunisia-Canada dual degree', 'Campus in Québec', 'Internationally recognized diploma'],
    image: '/images/programmes/banner-canada.jpg',
    logo: '/images/partners/uqat.svg',
    duration: '1 year (2 semesters in Quebec)',
    tuition: '~12,000 CAD/year (differential fees for international students)',
    language: 'French (DELF B2 recommended, EBS placement test accepted)',
    housing: 'UQAT student residences (~350–450 CAD/month). Dedicated housing service.',
    visa: 'Canadian study permit (CAQ + federal permit). EBS provides acceptance letter and support.',
    eligibility: 'Completed L2 or L3 at EBS with GPA ≥ 12/20. Full application reviewed by UQAT.',
  },
  {
    name: 'EM Normandie',
    fullName: 'École de Management de Normandie',
    country: 'France',
    flag: 'FR',
    description: 'Leading French business school, member of the Conférence des Grandes Écoles. AACSB, EQUIS and AMBA accredited.',
    programmes: ['Management', 'Marketing', 'Finance'],
    advantages: ['Triple international accreditation', 'Global alumni network', 'Internships in France'],
    image: '/images/events/em-normandie-visit.jpg',
    logo: '/images/partners/em-normandie-logo.png',
    duration: '1 to 2 years (Master or final Bachelor year)',
    tuition: '~€8,500–12,000/year depending on program',
    language: 'French and/or English depending on track (TOEFL/IELTS for English track)',
    housing: 'Private student residences (~€400–600/month). EM Normandie housing office.',
    visa: 'Long-stay student visa for France (VLS-TS). EBS + EM Normandie provide documents.',
    eligibility: 'Completed L3 at EBS with GPA ≥ 12/20. Motivation interview with EM Normandie.',
  },
  {
    name: 'Collège de Paris',
    fullName: 'Collège de Paris',
    country: 'France',
    flag: 'FR',
    description: 'Network of higher education institutions in France. Gateway to specialized programmes in Paris.',
    programmes: ['Management', 'Marketing', 'Finance'],
    advantages: ['Study in Paris', 'French professional network', 'Varied specializations'],
    image: '/images/international/paris-student.png',
    logo: '/images/partners/college-de-paris.png',
    duration: '1 year (final Master year, work-study possible)',
    tuition: '~€7,000–10,000/year (work-study covered by employer)',
    language: 'French (B2 minimum required)',
    housing: 'Independent housing in Paris (~€500–800/month). Network assistance available.',
    visa: 'Long-stay student visa for France (VLS-TS). EBS administrative support.',
    eligibility: 'Completed L3 or M1 at EBS with GPA ≥ 11/20. Interview + motivation letter.',
  },
  {
    name: 'Keyce Academy',
    fullName: 'Keyce Academy',
    country: 'France',
    flag: 'FR',
    description: 'IT and digital school in France. Partnership for the Computer Science & Software Engineering track.',
    programmes: ['Computer Science & Software Engineering'],
    advantages: ['IT specialization in France', 'Work-study in French companies', 'Tech network'],
    image: '/images/international/em-strasbourg.jpg',
    logo: '/images/partners/keyce-academy.png',
    duration: '1 to 2 years (Bachelor 3 or Master cycle, work-study)',
    tuition: '~€6,000–9,000/year (work-study: €0 for student)',
    language: 'French (B2 level). Technical English recommended.',
    housing: 'Student residences (~€350–550/month depending on city). Keyce assistance.',
    visa: 'Long-stay student visa for France (VLS-TS). Application supported by EBS.',
    eligibility: 'Completed L2 or L3 in Computer Science at EBS. GPA ≥ 12/20. Technical project to present.',
  },
];

const title = "International Pathways — EBS Tunis";
const description = "Study in Canada or France through EBS partnerships: UQAT, EM Normandie, Collège de Paris, Keyce Academy. Dual degrees and international pathways.";
---

<BaseLayout title={title} description={description} lang="en">
  <div class="w-full bg-surface text-ink antialiased">

    {/* ───────────────── HERO ───────────────── */}
    <section class="relative bg-navy overflow-hidden min-h-[55vh] flex items-center" aria-labelledby="intl-hero">
      <img src="/images/international/campus-france.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="eager" aria-hidden="true" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 pt-20 pb-16 md:pt-28 md:pb-20 lg:pt-36 lg:pb-24 relative z-10">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-xs text-white/40 font-medium">
            <li><a href="/en" class="hover:text-accent transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70">International</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-5">3 countries · {partners.length} partners · Dual degree</p>
          <h1 id="intl-hero" class="font-heading font-bold text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.08] text-white tracking-tight mb-5">
            Your degree opens<br/>doors worldwide<Marker size="lg" class="inline-block ml-3 align-middle" />
          </h1>
          <p class="font-body text-base-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8">
            Thanks to our partnerships with universities in Canada and France, you can continue your studies abroad with full credit recognition.
          </p>

          <div class="flex flex-wrap items-center gap-4 mb-10">
            {[
              { code: 'TN', label: 'Tunisia' },
              { code: 'CA', label: 'Canada' },
              { code: 'FR', label: 'France' },
            ].map(c => (
              <div class="flex items-center gap-2 px-4 py-2 bg-white/[0.07] border border-white/10">
                <Fragment set:html={flags[c.code].svg} />
                <span class="text-sm text-white/80 font-medium">{c.label}</span>
              </div>
            ))}
          </div>

          <Button href="/en/programmes" variant="ghost" size="lg" class="text-white/70 hover:text-accent">
            See eligible programmes
          </Button>
        </div>
      </div>
    </section>


    {/* ───────────────── HOW IT WORKS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface-alt reveal" aria-labelledby="how-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Typical pathway</p>
          <h2 id="how-heading" class="font-heading font-bold text-h2 text-ink">
            How does it work?
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
          {[
            { step: '01', title: 'Bachelor at EBS', desc: '3 years of training in Tunis with certifications and work-study programmes.' },
            { step: '02', title: 'Application', desc: 'Simplified application process through the partnership. No additional entrance exam.' },
            { step: '03', title: 'Transfer', desc: 'Full recognition of LMD credits. Direct integration into the partner programme.' },
            { step: '04', title: 'Dual degree', desc: 'EBS diploma + partner diploma. Two countries, one career.' },
          ].map((item, i) => (
            <div class="relative reveal" style={`--delay: ${i * 80}ms`}>
              <div class="bg-surface border border-border/40 p-6 h-full">
                <span class="font-heading font-bold text-2xl text-accent/30 mb-3 block">{item.step}</span>
                <h3 class="font-heading font-semibold text-base text-ink mb-2">{item.title}</h3>
                <p class="text-sm text-ink-body leading-relaxed">{item.desc}</p>
              </div>
              {i < 3 && (
                <span class="hidden md:block absolute top-1/2 -right-3 text-accent/40 z-10" aria-hidden="true">▸</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── PARTNER CARDS ───────────────── */}
    <section class="py-20 lg:py-28 bg-surface reveal" aria-labelledby="partners-heading">
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">Our partners</p>
            <h2 id="partners-heading" class="font-heading font-bold text-h2 text-ink leading-tight">
              Partner universities<Marker size="lg" class="inline-block ml-3 align-middle" />
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="font-body text-ink-body text-base leading-relaxed">
              Each partnership is structured to guarantee recognition of your credits and a smooth integration.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {partners.map((partner, i) => (
            <article class="group bg-surface border border-border/40 overflow-hidden flex flex-col reveal" style={`--delay: ${i * 60}ms`}>
              <div class="relative h-48 overflow-hidden">
                <img src={partner.image} alt={partner.fullName} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/30 to-transparent"></div>
                <div class="absolute top-4 left-4">
                  <img src={partner.logo} alt={partner.name} class="h-10 w-auto object-contain bg-white/90 p-1.5" loading="lazy" />
                </div>
                <div class="absolute bottom-0 left-0 px-8 pb-5">
                  <div class="flex items-center gap-3 mb-2">
                    <Fragment set:html={flags[partner.flag].svg} />
                    <span class="text-white/60 text-xs font-semibold uppercase tracking-wider">{partner.country}</span>
                  </div>
                  <h3 class="font-heading font-bold text-xl text-white leading-tight">{partner.name}</h3>
                  <p class="text-sm text-white/60 mt-1">{partner.fullName}</p>
                </div>
              </div>

              <div class="px-8 py-7 flex flex-col flex-1">
                <p class="font-body text-ink-body text-sm leading-relaxed mb-5">{partner.description}</p>

                <div class="mb-5">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-2">Eligible programmes</p>
                  <div class="flex flex-wrap gap-1.5">
                    {partner.programmes.map(prog => (
                      <span class="inline-block px-2.5 py-1 bg-accent/5 text-ink text-xs font-medium">{prog}</span>
                    ))}
                  </div>
                </div>

                <div class="mb-5">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-2">Advantages</p>
                  <ul class="space-y-2">
                    {partner.advantages.map(adv => (
                      <li class="flex items-start gap-2 text-sm text-ink-body">
                        <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-1.5" aria-hidden="true"></span>
                        {adv}
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Operational details grid */}
                <div class="grid grid-cols-2 gap-3 mb-5">
                  <div class="bg-surface-alt px-3 py-2.5 border border-border/20">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-1">Duration</p>
                    <p class="text-xs text-ink-body">{partner.duration}</p>
                  </div>
                  <div class="bg-surface-alt px-3 py-2.5 border border-border/20">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-1">Tuition</p>
                    <p class="text-xs text-ink-body">{partner.tuition}</p>
                  </div>
                  <div class="bg-surface-alt px-3 py-2.5 border border-border/20">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-1">Language</p>
                    <p class="text-xs text-ink-body">{partner.language}</p>
                  </div>
                  <div class="bg-surface-alt px-3 py-2.5 border border-border/20">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-1">Housing</p>
                    <p class="text-xs text-ink-body">{partner.housing}</p>
                  </div>
                </div>
                <div class="bg-accent/5 border border-accent/15 px-4 py-3 mb-5">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-accent mb-1">Visa & Support</p>
                  <p class="text-xs text-ink-body">{partner.visa}</p>
                </div>
                <div class="mb-5">
                  <p class="text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-1">Eligibility</p>
                  <p class="text-xs text-ink-body">{partner.eligibility}</p>
                </div>

                <div class="mt-auto pt-5 border-t border-border/30">
                  <a href="/en/programmes" class="inline-flex items-center text-sm font-semibold text-navy hover:text-accent transition-colors gap-1.5 hover:gap-2.5">
                    View programmes <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>


    {/* ───────────────── ALUMNI MAP ───────────────── */}
    <AlumniMap lang="en" />


    {/* ───────────────── CTA ───────────────── */}
    <section class="relative py-20 lg:py-28 overflow-hidden" aria-label="Registration">
      <img src="/images/international/em-presentiel.png" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true" />
      <div class="absolute inset-0 bg-accent/90"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 text-center relative z-10">
        <p class="text-xs font-semibold text-base-950/50 uppercase tracking-wider mb-4">Canada · France · Tunisia</p>
        <h2 class="font-heading font-bold text-[clamp(1.75rem,4vw,3rem)] leading-[1.1] text-base-950 mb-5">
          Your international journey starts here<Marker size="lg" class="inline-block ml-3 align-middle bg-base-950" />
        </h2>
        <p class="font-body text-base-950/60 text-lg mb-10 max-w-md mx-auto">
          Explore eligible programmes and start your pre-registration.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/en/pre-registration" variant="inverted" size="lg">
            Start my pre-registration <span class="ml-2" aria-hidden="true">→</span>
          </Button>
          <Button href="/en/programmes" variant="ghost" size="lg" class="text-base-950/70 hover:text-base-950">
            View programmes
          </Button>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease-out-expo), transform 0.6s var(--ease-out-expo);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll<HTMLElement>('.reveal');
    if (reveals.length) {
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); }
        }),
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      reveals.forEach((el) => obs.observe(el));
    }
  });
</script>
