---
import Button from '../ui/Button.astro';
import { navLinks, ui, switchLocalePath, type Locale } from '../../lib/i18n';

interface Props { lang?: Locale; }
const { lang = 'fr' } = Astro.props;
const links = navLinks[lang];
const t = ui[lang];
const currentPath = Astro.url.pathname;
const frPath = lang === 'fr' ? currentPath : switchLocalePath(currentPath, 'fr');
const enPath = lang === 'en' ? currentPath : switchLocalePath(currentPath, 'en');
---

{/* ─── MINI TOP BAR ─── */}
<div class="w-full bg-base-950 text-white/60 text-[11px] font-medium hidden md:block z-50 relative">
  <div class="max-w-7xl mx-auto px-6 h-9 flex items-center justify-between">
    <div class="flex items-center gap-5">
      <a href="tel:+21629582835" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        +216 29 58 28 35
      </a>
      <a href="mailto:admission@ebs.tn" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        admission@ebs.tn
      </a>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Les Berges du Lac, Tunis
      </span>
    </div>
    <div class="flex items-center gap-4">
      <div class="flex text-micro font-medium text-white/60">
        {lang === 'fr' ? (
          <><span class="text-white font-bold">FR</span><span class="mx-1">|</span><a href={enPath} class="hover:text-accent transition-colors">EN</a></>
        ) : (
          <><a href={frPath} class="hover:text-accent transition-colors">FR</a><span class="mx-1">|</span><span class="text-white font-bold">EN</span></>
        )}
      </div>
    </div>
  </div>
</div>

{/* ─── MAIN NAV ─── */}
<header class="sticky top-0 z-40 w-full bg-navy/95 backdrop-blur-md border-b border-white/10 shadow-sm transition-all" transition:name="nav">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={t.homeHref} class="flex items-center group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 ring-offset-navy" transition:name="logo">
      <img
        src="/images/logos/ebs-logo.png"
        alt="EBS — Espima Business School"
        width="120"
        height="28"
        class="h-9 w-auto object-contain group-hover:opacity-80 transition-opacity"
      />
    </a>

    {/* Desktop nav with dropdowns */}
    <nav class="hidden lg:flex items-center space-x-1" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      {links.map(link => (
        link.children ? (
          <div class="nav-dropdown relative group/dd">
            <button type="button" class="nav-dd-trigger flex items-center gap-1 px-3 py-2 text-small font-semibold text-white/90 hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">
              {link.label}
              <svg class="w-3.5 h-3.5 text-white/40 group-hover/dd:text-accent transition-all duration-200 nav-dd-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-panel absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 transition-all duration-200 pointer-events-none z-50">
              <div class="bg-navy border border-white/10 shadow-2xl shadow-black/40 min-w-[240px]">
                {link.children.map(child => (
                  <a href={child.href} class="flex flex-col px-5 py-3.5 hover:bg-white/[0.06] transition-colors border-b border-white/5 last:border-0">
                    <span class="text-sm font-semibold text-white">{child.label}</span>
                    {child.desc && <span class="text-[11px] text-white/40 mt-0.5">{child.desc}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} class="px-3 py-2 text-small font-semibold text-white/90 hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{link.label}</a>
        )
      ))}
    </nav>

    <div class="flex items-center space-x-3">
      {/* Search trigger */}
      <button data-search-trigger class="hidden md:flex items-center justify-center w-9 h-9 text-white/60 hover:text-accent transition-colors" aria-label="Rechercher (Ctrl+K)">
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>

      {/* Dark mode toggle */}
      <button id="dark-toggle" class="hidden sm:flex items-center justify-center w-9 h-9 text-white/80 hover:text-accent transition-colors" aria-label="Basculer le mode sombre">
        <svg class="w-4.5 h-4.5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="w-4.5 h-4.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>

      <Button href={t.preRegistrationHref} variant="primary" size="sm" class="hidden sm:inline-flex">
        {t.preRegistration}
      </Button>

      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile drawer */}
  <nav
    id="mobile-menu"
    class="lg:hidden overflow-hidden transition-[max-height] duration-300 ease-in-out max-h-0 bg-navy border-t border-white/10"
    aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}
  >
    <div class="px-6 py-6 flex flex-col gap-1">
      {links.map(link => (
        link.children ? (
          <div class="mobile-dd">
            <button type="button" class="mobile-dd-trigger w-full flex items-center justify-between py-3 text-base font-semibold text-white/90 hover:text-accent transition-colors border-b border-white/5">
              {link.label}
              <svg class="w-4 h-4 text-white/40 transition-transform duration-200 mobile-dd-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="mobile-dd-content overflow-hidden transition-all duration-200" style="max-height:0">
              <div class="pl-4 py-2 space-y-1">
                {link.children.map(child => (
                  <a href={child.href} class="block py-2 text-sm text-white/70 hover:text-accent transition-colors">{child.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} class="py-3 text-base font-semibold text-white/90 hover:text-accent transition-colors border-b border-white/5">{link.label}</a>
        )
      ))}
      <div class="flex items-center gap-3 pt-4 text-sm font-medium text-white/60">
        {lang === 'fr' ? (
          <><span class="text-white font-bold">FR</span><span>/</span><a href={enPath} class="hover:text-accent transition-colors">EN</a></>
        ) : (
          <><a href={frPath} class="hover:text-accent transition-colors">FR</a><span>/</span><span class="text-white font-bold">EN</span></>
        )}
      </div>
      <a href={t.preRegistrationHref} class="mt-3 inline-flex items-center justify-center px-6 py-3 bg-accent text-base-950 font-heading font-semibold text-sm hover:bg-accent-hover transition-colors text-center">
        {t.preRegistration}
      </a>
    </div>
  </nav>
</header>

<style>
  /* Desktop dropdown hover behavior */
  .nav-dropdown:hover .nav-dd-panel,
  .nav-dropdown:focus-within .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .nav-dropdown:hover .nav-dd-chevron,
  .nav-dropdown:focus-within .nav-dd-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    /* Mobile menu toggle */
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!toggle || !menu || !hamburger || !closeIcon) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        menu.style.maxHeight = '0';
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        menu.style.maxHeight = menu.scrollHeight + 'px';
        hamburger.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    /* Close on link click */
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.style.maxHeight = '0';
        toggle.setAttribute('aria-expanded', 'false');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });

    /* Mobile dropdown accordions */
    document.querySelectorAll<HTMLElement>('.mobile-dd').forEach(dd => {
      const trigger = dd.querySelector<HTMLButtonElement>('.mobile-dd-trigger');
      const content = dd.querySelector<HTMLElement>('.mobile-dd-content');
      const chevron = dd.querySelector<HTMLElement>('.mobile-dd-chevron');
      if (!trigger || !content) return;

      trigger.addEventListener('click', () => {
        const isOpen = content.style.maxHeight !== '0px' && content.style.maxHeight !== '';
        if (isOpen) {
          content.style.maxHeight = '0';
          if (chevron) chevron.style.transform = '';
        } else {
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(180deg)';
          /* Recalc parent mobile menu height */
          if (menu) menu.style.maxHeight = menu.scrollHeight + content.scrollHeight + 'px';
        }
      });
    });
  });
</script>
