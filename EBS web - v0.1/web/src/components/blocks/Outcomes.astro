---
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';

const stats = [
  { value: 68, suffix: '%', label: isFr ? 'employés en 6 mois' : 'employed in 6 months', source: isFr ? 'promotion 2024, enquête interne, N=127' : 'class of 2024, internal survey, N=127' },
  { value: 450, suffix: '+', label: isFr ? 'diplômés depuis 2013' : 'graduates since 2013', source: isFr ? 'registre EBS, mai 2025' : 'EBS records, May 2025' },
  { value: 92, suffix: '%', label: isFr ? 'taux de réussite aux examens' : 'exam success rate', source: isFr ? 'année 2023-2024' : '2023-2024 academic year' },
];

const testimonials = [
  {
    quote: isFr
      ? "Le jour de mon entretien, le recruteur a vu ma certification AWS et a dit : on peut passer directement au technique."
      : 'During my interview, the recruiter saw my AWS certification and said: let\'s skip straight to the technical round.',
    name: 'Amine H.',
    promo: isFr ? 'promotion 2024' : 'class of 2024',
    company: 'Vermeg',
    image: '/images/alumni/amin-hamdi.jpg',
  },
  {
    quote: isFr
      ? "Grâce à l'alternance, j'avais déjà 18 mois d'expérience le jour de ma soutenance. Trois offres en une semaine."
      : 'Thanks to work-study, I already had 18 months of experience on graduation day. Three offers in one week.',
    name: 'Maroua J.',
    promo: isFr ? 'promotion 2023' : 'class of 2023',
    company: 'Telnet',
    image: '/images/alumni/maroua-jeribi.jpg',
  },
  {
    quote: isFr
      ? "Mon parcours à l'EBS m'a ouvert les portes de l'international. Aujourd'hui je travaille entre Tunis et Paris."
      : 'My journey at EBS opened international doors. Today I work between Tunis and Paris.',
    name: 'Dorra B.',
    promo: isFr ? 'promotion 2022' : 'class of 2022',
    company: 'Sofrecom',
    image: '/images/alumni/dorra-ben-turkia.jpg',
  },
];
---

<section id="outcomes" class="relative py-20 lg:py-28 overflow-hidden" aria-labelledby="outcomes-heading">
  {/* Background image with overlay */}
  <div class="absolute inset-0 z-0">
    <img src="/images/campus/students-4.jpg" alt="" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-navy/92"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 relative z-10">

    {/* ── Header ── */}
    <div class="mb-14 max-w-xl">
      <span class="text-xs font-bold text-accent uppercase tracking-wider mb-3 block">{isFr ? 'Résultats' : 'Results'}</span>
      <h2 id="outcomes-heading" class="font-heading font-bold text-h2 text-base-50 mb-4">
        {isFr ? 'Les résultats parlent' : 'The results speak'}<span class="text-accent">.</span>
      </h2>
      <p class="font-body text-base-300 text-body-lg leading-relaxed">
        {isFr ? 'Des chiffres concrets et des témoignages de nos diplômés.' : 'Real numbers and testimonials from our graduates.'}
      </p>
    </div>

    {/* ── Stats cards ── */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-16">
      {stats.map((s, i) => (
        <div class="reveal group bg-white/5 border border-white/10 backdrop-blur-sm overflow-hidden hover:bg-white/10 transition-colors" style={`--delay: ${i * 80}ms`}>
          <div class="px-8 pt-7 pb-5 relative overflow-hidden">
            <span class="absolute -right-4 -top-4 font-heading font-bold text-[6rem] leading-none text-white/5 select-none" aria-hidden="true">{s.value}{s.suffix}</span>
            <span class="relative font-heading font-black text-[3rem] leading-none text-accent" data-countup={String(s.value)} data-suffix={s.suffix}>0</span>
          </div>
          <div class="px-8 py-5">
            <p class="font-heading font-semibold text-white text-sm mb-1">{s.label}</p>
            <p class="text-xs text-white/50">({s.source})</p>
          </div>
          <div class="h-1 bg-accent/20 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    {/* ── Testimonial carousel ── */}
    <div class="relative">
      <div class="overflow-hidden" id="testimonial-carousel">
        <div class="flex transition-transform duration-500 ease-out" id="testimonial-track">
          {testimonials.map((t, i) => (
            <blockquote class="w-full md:w-1/3 flex-shrink-0 px-2.5">
              <div class="group bg-white/5 border border-white/10 backdrop-blur-sm overflow-hidden flex flex-col hover:bg-white/10 transition-colors h-full">
                <div class="px-8 pt-8 pb-6 flex-1 flex flex-col">
                  <svg class="w-8 h-8 text-accent/40 mb-4 shrink-0" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                    <path d="M10 8c-3.3 0-6 2.7-6 6v10h10V14H8c0-1.1.9-2 2-2V8zm14 0c-3.3 0-6 2.7-6 6v10h10V14h-6c0-1.1.9-2 2-2V8z"/>
                  </svg>
                  <p class="font-body text-white/90 text-base leading-relaxed mb-6 flex-1">
                    {t.quote}
                  </p>
                  <footer class="flex items-center gap-4 pt-4 border-t border-white/10">
                    <img src={t.image} alt={t.name} class="w-12 h-12 object-cover shrink-0 grayscale group-hover:grayscale-0 transition-all duration-300" loading="lazy" />
                    <div>
                      <cite class="not-italic font-heading font-semibold text-white text-sm block">{t.name}</cite>
                      <span class="text-xs text-white/50">{t.promo} · {t.company}</span>
                    </div>
                  </footer>
                </div>
                <div class="h-1 bg-accent/20 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
              </div>
            </blockquote>
          ))}
        </div>
      </div>
      {/* Carousel indicators */}
      <div class="flex items-center justify-center gap-2 mt-6">
        {testimonials.map((_, i) => (
          <button class="carousel-dot w-2 h-2 bg-white/20 transition-all duration-300" data-index={i} aria-label={`${isFr ? 'Témoignage' : 'Testimonial'} ${i + 1}`}></button>
        ))}
      </div>
      {/* Prev / Next buttons */}
      <button id="carousel-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-10 h-10 bg-white/10 text-white flex items-center justify-center hover:bg-accent hover:text-base-950 transition-colors hidden md:flex" aria-label={isFr ? 'Précédent' : 'Previous'}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="carousel-next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-10 h-10 bg-white/10 text-white flex items-center justify-center hover:bg-accent hover:text-base-950 transition-colors hidden md:flex" aria-label={isFr ? 'Suivant' : 'Next'}>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    {/* ── Employers strip ── */}
    <div class="mt-16 reveal">
      <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-6 text-center">{isFr ? 'Nos diplômés travaillent chez' : 'Our graduates work at'}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {['Vermeg', 'Telnet', 'Sofrecom', 'Biat', 'Amen Bank', 'Tunisair', 'Orange', 'SAP'].map(employer => (
          <span class="text-base font-heading font-bold text-white/40 hover:text-accent/70 transition-colors tracking-wide">{employer}</span>
        ))}
      </div>
    </div>



  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .stat-card, .testimonial-card { animation: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const track = document.getElementById('testimonial-track') as HTMLElement | null;
    const dots = document.querySelectorAll<HTMLElement>('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    if (!track || !dots.length) return;

    let current = 0;
    const total = dots.length;

    function goTo(idx: number) {
      current = ((idx % total) + total) % total;
      /* On mobile, translate full width; on md+, show all 3 so no translate needed */
      const isMd = window.matchMedia('(min-width: 768px)').matches;
      if (isMd) {
        track!.style.transform = '';
      } else {
        track!.style.transform = `translateX(-${current * 100}%)`;
      }
      dots.forEach((d, i) => {
        d.classList.toggle('bg-accent', i === current);
        d.classList.toggle('bg-white/20', i !== current);
        d.classList.toggle('w-6', i === current);
      });
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    goTo(0);
  });
</script>
