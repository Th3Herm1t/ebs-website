---
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';

const schedule = [
  { day: isFr ? 'Lun' : 'Mon', type: 'ebs' },
  { day: isFr ? 'Mar' : 'Tue', type: 'ebs' },
  { day: isFr ? 'Mer' : 'Wed', type: 'ebs' },
  { day: isFr ? 'Jeu' : 'Thu', type: 'ent' },
  { day: isFr ? 'Ven' : 'Fri', type: 'ent' },
];

const companies = ['Vermeg', 'Sofrecom', 'Asteelflash', 'Telnet', 'Satoripop'];

const benefits = [
  { value: 2, suffix: '', label: isFr ? 'ans de rythme pro' : 'years of professional pace', detail: isFr ? 'Pas un stage. Un vrai poste, chaque semaine.' : 'Not an internship. A real position, every week.' },
  { value: 18, suffix: '', label: isFr ? 'mois d\'expérience' : 'months of experience', detail: isFr ? 'Le jour de ta soutenance, tu as déjà un CV solide.' : 'On graduation day, you already have a solid CV.' },
  { value: 5, suffix: '+', label: isFr ? 'entreprises partenaires' : 'partner companies', detail: isFr ? 'Des sociétés qui recrutent nos alternants à la sortie.' : 'Companies that hire our work-study graduates.' },
];
---

<section id="alternance" class="relative py-20 lg:py-28 overflow-hidden" aria-labelledby="alternance-heading">
  {/* Background with real image */}
  <div class="absolute inset-0 z-0">
    <img src="/images/events/visite-dot.jpg" alt="" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-navy/93"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 relative z-10">

    {/* ── Header row ── */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
      <div>
        <span class="text-xs font-bold text-accent uppercase tracking-wider mb-3 block">{isFr ? 'Alternance' : 'Work-Study'}</span>
        <h2 id="alternance-heading" class="font-heading font-bold text-h2 text-base-50 mb-4">
          {isFr ? '3 jours EBS' : '3 days EBS'}<span class="text-accent">.</span> {isFr ? '2 jours entreprise' : '2 days company'}<span class="text-accent">.</span>
        </h2>
        <p class="font-body text-base-300 text-body-lg leading-relaxed mb-6">
          {isFr
            ? <Fragment>L’alternance, c’est <strong class="text-base-50">apprendre un métier en le pratiquant</strong>. Pas un stage de fin d’études — un vrai rythme professionnel, chaque semaine.</Fragment>
            : <Fragment>Work-study means <strong class="text-base-50">learning a profession by practicing it</strong>. Not a final-year internship — a real professional rhythm, every week.</Fragment>}
        </p>
        <a href={isFr ? '/alternance' : '/en/work-study'} class="inline-flex items-center text-sm font-semibold text-accent hover:text-white transition-colors gap-1 hover:gap-2">
          {isFr ? 'En savoir plus' : 'Learn more'} <span aria-hidden="true">→</span>
        </a>
      </div>
      {/* Image showcase */}
      <div class="hidden lg:block relative">
        <div class="grid grid-cols-2 gap-3">
          <div class="overflow-hidden reveal" style="--delay: 0ms">
            <img src="/images/events/partenariat-asteelflash.jpg" alt="Partenariat entreprise" class="w-full h-40 object-cover hover:scale-110 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="overflow-hidden reveal" style="--delay: 100ms">
            <img src="/images/events/seminaire-draoui.jpg" alt="Séminaire professionnel" class="w-full h-40 object-cover hover:scale-110 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="overflow-hidden col-span-2 reveal" style="--delay: 200ms">
            <img src="/images/events/it-business-expo.jpg" alt="IT Business Expo" class="w-full h-40 object-cover hover:scale-110 transition-transform duration-500" loading="lazy" />
          </div>
        </div>
      </div>
    </div>

    {/* ── Schedule strip ── */}
    <div class="bg-white/5 border border-white/10 p-4 sm:p-6 mb-16 backdrop-blur-sm reveal">
      <p class="text-xs font-semibold text-base-400 uppercase tracking-wider mb-4">{isFr ? 'Planning hebdomadaire' : 'Weekly schedule'}</p>
      <div class="flex gap-2 sm:gap-3 mb-4" role="img" aria-label="Lundi à mercredi à EBS, jeudi et vendredi en entreprise">
        {schedule.map((s) => (
          <div class={`flex-1 py-5 sm:py-7 text-center font-heading font-bold text-sm sm:text-base transition-colors ${s.type === 'ebs' ? 'bg-white/10 text-white border border-white/10' : 'bg-accent text-base-950'}`}>
            {s.day}
          </div>
        ))}
      </div>
      <div class="flex items-center gap-6 text-sm text-base-400 font-medium">
        <span class="flex items-center gap-2"><span class="w-3 h-3 bg-white/20 inline-block" aria-hidden="true"></span> EBS</span>
        <span class="flex items-center gap-2"><span class="w-3 h-3 bg-accent inline-block" aria-hidden="true"></span> {isFr ? 'Entreprise' : 'Company'}</span>
      </div>
    </div>

    {/* ── Benefit cards ── */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-16">
      {benefits.map((b, i) => (
        <div class="reveal group border border-white/10 overflow-hidden bg-white/5 backdrop-blur-sm hover:bg-white/10 transition-colors" style={`--delay: ${i * 80}ms`}>
          <div class="px-8 pt-7 pb-5 relative overflow-hidden">
            <span class="absolute -right-3 -top-3 font-heading font-bold text-[5rem] leading-none text-white/3 select-none" aria-hidden="true">{b.value}{b.suffix}</span>
            <div class="relative flex items-end gap-3">
              <span class="font-heading font-bold text-[2.5rem] leading-none text-accent" data-countup={String(b.value)} data-suffix={b.suffix || undefined}>0</span>
              <span class="font-heading font-semibold text-sm text-white/70 pb-1">{b.label}</span>
            </div>
          </div>
          <div class="px-8 pb-6">
            <p class="font-body text-base-300 text-sm leading-relaxed">{b.detail}</p>
          </div>
          <div class="h-1 bg-accent/20 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    {/* ── Partner companies bar with logos ── */}
    <div class="bg-white/5 border border-white/10 px-8 py-6 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 backdrop-blur-sm reveal">
      <div class="flex items-center gap-3 shrink-0">
        <span class="w-2.5 h-2.5 bg-accent shrink-0" aria-hidden="true"></span>
        <span class="font-heading font-bold text-white text-base">{isFr ? 'Entreprises partenaires' : 'Partner companies'}</span>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {companies.map((c) => (
          <span class="text-base font-semibold text-base-200">{c}</span>
        ))}
      </div>
    </div>

  </div>
</section>
