---
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';
---

<section id="values" class="bg-surface py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">

      {/* ── Certifications ── */}
      <article class="value-card group overflow-hidden flex flex-col reveal" style="--delay: 0ms">
        <div class="relative h-52 overflow-hidden">
          <img src="/images/events/conference-digital.jpg" alt={isFr ? 'Étudiants en session de certification' : 'Students in certification session'} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-6">
            <div class="flex items-end gap-4">
              <span class="font-heading font-bold text-[3.5rem] leading-none text-accent">36</span>
              <span class="font-heading font-semibold text-base text-white/90 pb-2">{isFr ? <>certifications<br/>professionnelles</> : <>professional<br/>certifications</>}</span>
            </div>
          </div>
        </div>
        <div class="px-8 py-6 flex flex-col flex-1 bg-surface border border-t-0 border-border/40">
          <p class="font-body text-ink-body leading-relaxed mb-4">
            {isFr
              ? "AWS, Google Cloud, IBM, Salesforce — chaque certification est reconnue mondialement et s'affiche sur ton profil LinkedIn."
              : 'AWS, Google Cloud, IBM, Salesforce — every certification is globally recognized and shows on your LinkedIn profile.'}
          </p>
          <div class="mt-auto flex flex-wrap gap-2">
            {['AWS', 'Google', 'IBM', 'Salesforce'].map(name => (
              <span class="inline-block px-2.5 py-1 bg-navy/8 text-navy text-xs font-semibold">{name}</span>
            ))}
          </div>
        </div>
        <div class="h-1 bg-accent/30 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
      </article>

      {/* ── International ── */}
      <article class="value-card group overflow-hidden flex flex-col reveal" style="--delay: 100ms">
        <div class="relative h-52 overflow-hidden">
          <img src="/images/international/paris-student.png" alt={isFr ? 'Étudiante à Paris' : 'Student in Paris'} class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-700" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-6">
            <div class="flex items-end gap-4">
              <span class="font-heading font-bold text-[3.5rem] leading-none text-accent">3</span>
              <span class="font-heading font-semibold text-base text-white/90 pb-2">{isFr ? <>pays,<br/>un seul diplôme</> : <>countries,<br/>one degree</>}</span>
            </div>
          </div>
        </div>
        <div class="px-8 py-6 flex flex-col flex-1 bg-surface border border-t-0 border-border/40">
          <p class="font-body text-ink-body leading-relaxed mb-4">
            {isFr
              ? "Poursuis ton Master au Canada avec l'UQAT ou en France avec EM Normandie — sans repartir de zéro."
              : 'Continue your Master\'s in Canada with UQAT or in France with EM Normandie — without starting over.'}
          </p>
          <div class="mt-auto flex items-center gap-3 text-sm">
            <span class="inline-flex items-center gap-1.5 text-ink-muted font-medium">
              <span class="w-2 h-2 bg-accent shrink-0" aria-hidden="true"></span>{isFr ? 'Tunisie' : 'Tunisia'}
            </span>
            <span class="inline-flex items-center gap-1.5 text-ink-muted font-medium">
              <span class="w-2 h-2 bg-navy shrink-0" aria-hidden="true"></span>Canada
            </span>
            <span class="inline-flex items-center gap-1.5 text-ink-muted font-medium">
              <span class="w-2 h-2 bg-navy shrink-0" aria-hidden="true"></span>France
            </span>
          </div>
        </div>
        <div class="h-1 bg-accent/30 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
      </article>

      {/* ── Alternance ── */}
      <article class="value-card group overflow-hidden flex flex-col reveal" style="--delay: 200ms">
        <div class="relative h-52 overflow-hidden">
          <img src="/images/events/partenariat-asteelflash.jpg" alt={isFr ? 'Étudiant en entreprise' : 'Student at company'} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 px-8 pb-6">
            <div class="flex items-end gap-4">
              <span class="font-heading font-bold text-[3.5rem] leading-none text-accent">L2</span>
              <span class="font-heading font-semibold text-base text-white/90 pb-2">{isFr ? <>en entreprise<br/>dès la 2ᵉ année</> : <>in company<br/>from year 2</>}</span>
            </div>
          </div>
        </div>
        <div class="px-8 py-6 flex flex-col flex-1 bg-surface border border-t-0 border-border/40">
          <p class="font-body text-ink-body leading-relaxed mb-4">
            {isFr
              ? "Tu alternes cours et missions en entreprise. Résultat : un CV solide avant même d'avoir ton diplôme."
              : 'You alternate between classes and company assignments. Result: a solid CV before you even graduate.'}
          </p>
          <div class="mt-auto flex items-center gap-6 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 bg-navy" aria-hidden="true"></span>
              <span class="text-ink-muted font-medium">EBS</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 bg-accent" aria-hidden="true"></span>
              <span class="text-ink-muted font-medium">{isFr ? 'Entreprise' : 'Company'}</span>
            </div>
          </div>
        </div>
        <div class="h-1 bg-accent/30 group-hover:bg-accent transition-colors duration-300" aria-hidden="true"></div>
      </article>

    </div>
  </div>
</section>
