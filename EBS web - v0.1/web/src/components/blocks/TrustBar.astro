---
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';

const allLogos = [
  { name: "AWS", logo: "/images/certifications/aws.svg" },
  { name: "Google Cloud", logo: "/images/certifications/google.svg" },
  { name: "IBM", logo: "/images/certifications/ibm.svg" },
  { name: "Cisco", logo: "/images/certifications/cisco.svg" },
  { name: "Microsoft", logo: "/images/certifications/microsoft.svg" },
  { name: "Oracle", logo: "/images/certifications/oracle.svg" },
  { name: "Salesforce", logo: "/images/certifications/salesforce.svg" },
  { name: "HubSpot", logo: "/images/certifications/hubspot.svg" },
  { name: "Tableau", logo: "/images/certifications/tableau.svg" },
  { name: "Ministère", logo: "/images/partners/ministere.gif" },
  { name: "UQAT", logo: "/images/partners/uqat.svg" },
  { name: "EM Normandie", logo: "/images/partners/em-normandie-logo.png" },
  { name: "Collège de Paris", logo: "/images/partners/college-de-paris.png" },
  { name: "Keyce Academy", logo: "/images/partners/keyce-academy.png" },
  { name: "Kedge", logo: "/images/partners/kedge.svg" },
  { name: "Université de Strasbourg", logo: "/images/partners/strasbourg.svg" },
];
---

<section id="trust-bar" class="w-full bg-surface py-5" style="overflow:hidden;" aria-label={isFr ? 'Ils nous font confiance' : 'Trusted by'}>
  <p class="text-[10px] font-bold text-ink-muted/60 uppercase tracking-widest mb-3 text-center">{isFr ? 'Ils nous font confiance' : 'Trusted by'}</p>
  <div id="trust-marquee-wrap" style="overflow:hidden;-webkit-mask-image:linear-gradient(to right,transparent,black 8%,black 92%,transparent);mask-image:linear-gradient(to right,transparent,black 8%,black 92%,transparent);">
    <div id="trust-marquee-track" style="display:flex !important;flex-direction:row !important;flex-wrap:nowrap !important;align-items:center;gap:3.5rem;width:max-content;will-change:transform;">
      {[...allLogos, ...allLogos, ...allLogos].map(item => (
        <img
          src={item.logo}
          alt={item.name}
          width="120"
          height="40"
          loading="lazy"
          decoding="async"
          style="display:inline-block !important;max-width:none !important;height:2.5rem;width:auto;flex-shrink:0;object-fit:contain;filter:grayscale(100%);opacity:0.7;"
        />
      ))}
    </div>
  </div>
</section>

<script>
  function initMarquee() {
    const track = document.getElementById('trust-marquee-track');
    if (!track || track.dataset.running) return;
    track.dataset.running = '1';

    let pos = 0;
    const speed = 0.5; // px per frame
    let paused = false;
    let raf: number;

    const wrap = document.getElementById('trust-marquee-wrap');
    wrap?.addEventListener('mouseenter', () => { paused = true; });
    wrap?.addEventListener('mouseleave', () => { paused = false; });

    // Total width of one set of logos (1/3 of track since we tripled)
    const thirdWidth = track.scrollWidth / 3;

    function step() {
      if (!paused) {
        pos -= speed;
        if (Math.abs(pos) >= thirdWidth) pos = 0;
        track!.style.transform = `translateX(${pos}px)`;
      }
      raf = requestAnimationFrame(step);
    }
    raf = requestAnimationFrame(step);
  }

  // Run on initial load and after View Transitions
  initMarquee();
  document.addEventListener('astro:page-load', initMarquee);
</script>
