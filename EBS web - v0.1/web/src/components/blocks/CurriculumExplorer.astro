---
/**
 * CurriculumExplorer.astro — Interactive visual timeline of a programme's curriculum
 * Shows year nodes on a timeline, expandable modules with animated transitions.
 * @prop lang - 'fr' | 'en'
 */
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;

const t = {
  fr: {
    kicker: 'Explorer les programmes',
    title: 'Parcours interactif',
    desc: 'Sélectionne un programme pour explorer son cursus année par année.',
    select: 'Choisir un programme',
    modules: 'modules',
    certs: 'Certifications incluses',
    click: 'Clique sur une année pour voir les détails',
  },
  en: {
    kicker: 'Explore programmes',
    title: 'Interactive pathway',
    desc: 'Select a programme to explore its curriculum year by year.',
    select: 'Choose a programme',
    modules: 'modules',
    certs: 'Included certifications',
    click: 'Click a year to see details',
  },
}[lang];

/* Inline programme data for the explorer */
const programmes = [
  {
    key: 'info',
    label: lang === 'fr' ? 'Licence Informatique' : 'BSc Computer Science',
    years: [
      { year: 'L1', title: lang === 'fr' ? 'Fondamentaux' : 'Fundamentals',  modules: ['Algorithmique', 'Base de données', 'Réseaux', 'Mathématiques', 'Anglais technique', 'Développement web'], certs: ['AWS Cloud Practitioner'] },
      { year: 'L2', title: lang === 'fr' ? 'Développement' : 'Development', modules: ['Java / OOP', 'Linux & Scripting', 'Architecture logicielle', 'Cloud Computing', 'Cybersécurité', 'Gestion de projet'], certs: ['AWS Solutions Architect', 'IBM DevOps'] },
      { year: 'L3', title: lang === 'fr' ? 'Spécialisation' : 'Specialization', modules: ['DevOps & CI/CD', 'Machine Learning', 'Big Data', 'Kubernetes', 'Stage', 'Projet de fin d\'études'], certs: ['AWS Developer Associate', 'Google Cloud Digital Leader'] },
    ],
  },
  {
    key: 'marketing',
    label: lang === 'fr' ? 'Licence Marketing Digital & IA' : 'BSc Digital Marketing & AI',
    years: [
      { year: 'L1', title: lang === 'fr' ? 'Fondamentaux Marketing' : 'Marketing Fundamentals', modules: ['Marketing fondamental', 'Communication', 'Économie', 'Statistiques', 'Design thinking', 'Outils digitaux'], certs: ['Google Digital Marketing'] },
      { year: 'L2', title: lang === 'fr' ? 'Digital & Data' : 'Digital & Data', modules: ['SEO / SEM', 'Social Media', 'Analytics', 'UX / UI', 'Content Marketing', 'CRM'], certs: ['Google Analytics', 'HubSpot Inbound'] },
      { year: 'L3', title: lang === 'fr' ? 'IA & Stratégie' : 'AI & Strategy', modules: ['IA appliquée marketing', 'Automation', 'E-commerce', 'Stratégie digitale', 'Stage', 'Projet de fin d\'études'], certs: ['Google Ads', 'Salesforce Marketing Cloud'] },
    ],
  },
  {
    key: 'finance',
    label: lang === 'fr' ? 'Licence Ingénierie Financière' : 'BSc Financial Engineering',
    years: [
      { year: 'L1', title: lang === 'fr' ? 'Fondamentaux Finance' : 'Finance Fundamentals', modules: ['Comptabilité', 'Microéconomie', 'Macroéconomie', 'Mathématiques financières', 'Droit des affaires', 'Anglais'], certs: [] },
      { year: 'L2', title: lang === 'fr' ? 'Analyse & Marchés' : 'Analysis & Markets', modules: ['Analyse financière', 'Marchés financiers', 'Fiscalité', 'Statistiques avancées', 'Finance d\'entreprise', 'Gestion de portefeuille'], certs: ['Bloomberg Market Concepts'] },
      { year: 'L3', title: lang === 'fr' ? 'Ingénierie' : 'Engineering', modules: ['Modélisation financière', 'Risk management', 'FinTech', 'Audit', 'Stage', 'Projet de fin d\'études'], certs: ['Oracle Financial Cloud'] },
    ],
  },
];
---

<section class="py-20 lg:py-28 bg-surface-alt" aria-label={t.title}>
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
    <div class="text-center mb-14 reveal">
      <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">{t.kicker}</p>
      <h2 class="font-heading font-bold text-h2 text-ink leading-tight mb-3">{t.title}</h2>
      <p class="font-body text-ink-body text-base max-w-xl mx-auto">{t.desc}</p>
    </div>

    {/* Programme selector */}
    <div class="flex flex-wrap justify-center gap-3 mb-12 reveal" style="--delay:80ms">
      {programmes.map((prog, i) => (
        <button
          type="button"
          data-explorer-prog={prog.key}
          class:list={[
            'explorer-prog-btn px-5 py-2.5 text-sm font-semibold border transition-all',
            i === 0 ? 'bg-navy text-white border-navy' : 'bg-surface text-ink-muted border-border/40 hover:border-accent/40',
          ]}
        >
          {prog.label}
        </button>
      ))}
    </div>

    {/* Timeline container */}
    {programmes.map((prog, pi) => (
      <div
        data-explorer-panel={prog.key}
        class:list={['explorer-panel', pi === 0 ? '' : 'hidden']}
      >
        {/* Timeline */}
        <div class="relative">
          {/* Horizontal line */}
          <div class="absolute top-8 left-0 right-0 h-0.5 bg-border/40 hidden md:block" aria-hidden="true"></div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {prog.years.map((yr, yi) => (
              <div class="relative reveal" style={`--delay:${yi * 120}ms`}>
                {/* Node dot */}
                <div class="hidden md:flex items-center justify-center w-16 h-16 mx-auto mb-6 bg-surface border-4 border-accent rounded-full relative z-10 explorer-node transition-transform hover:scale-110 cursor-pointer" data-explorer-year={`${prog.key}-${yi}`}>
                  <span class="font-heading font-bold text-lg text-accent">{yr.year}</span>
                </div>

                {/* Card */}
                <div class="bg-surface border border-border/40 p-6 hover:border-accent/30 transition-colors">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="md:hidden font-heading font-bold text-2xl text-accent">{yr.year}</span>
                    <div>
                      <h3 class="font-heading font-semibold text-lg text-ink">{yr.title}</h3>
                      <p class="text-xs text-ink-muted">{yr.modules.length} {t.modules}</p>
                    </div>
                  </div>

                  {/* Modules */}
                  <div class="space-y-2 mb-4 explorer-modules" data-explorer-modules={`${prog.key}-${yi}`}>
                    {yr.modules.map((mod, mi) => (
                      <div class="flex items-start gap-2.5 explorer-module opacity-0" style={`--mod-delay:${mi * 50}ms`}>
                        <span class="w-1.5 h-1.5 bg-accent shrink-0 mt-1.5" aria-hidden="true"></span>
                        <span class="text-sm text-ink-body">{mod}</span>
                      </div>
                    ))}
                  </div>

                  {/* Certs */}
                  {yr.certs.length > 0 && (
                    <div class="pt-3 border-t border-border/30">
                      <p class="text-[10px] font-bold text-accent uppercase tracking-wider mb-2">{t.certs}</p>
                      <div class="flex flex-wrap gap-1.5">
                        {yr.certs.map(cert => (
                          <span class="px-2 py-1 bg-accent/10 text-accent text-[11px] font-semibold">{cert}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}

    <p class="text-center text-xs text-ink-muted mt-8">{t.click}</p>
  </div>
</section>

<style>
  .explorer-module {
    animation: moduleReveal 0.4s ease forwards;
    animation-delay: var(--mod-delay, 0ms);
  }
  @keyframes moduleReveal {
    from { opacity: 0; transform: translateX(-8px); }
    to   { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const progBtns = document.querySelectorAll<HTMLButtonElement>('.explorer-prog-btn');
    const panels = document.querySelectorAll<HTMLElement>('.explorer-panel');
    if (!progBtns.length) return;

    progBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.explorerProg;

        // Toggle buttons
        progBtns.forEach(b => {
          const isActive = b === btn;
          b.classList.toggle('bg-navy', isActive);
          b.classList.toggle('text-white', isActive);
          b.classList.toggle('border-navy', isActive);
          b.classList.toggle('bg-surface', !isActive);
          b.classList.toggle('text-ink-muted', !isActive);
          b.classList.toggle('border-border/40', !isActive);
        });

        // Toggle panels
        panels.forEach(p => {
          p.classList.toggle('hidden', p.dataset.explorerPanel !== key);
        });

        // Re-trigger module animations
        const activePanel = document.querySelector(`[data-explorer-panel="${key}"]`);
        if (activePanel) {
          activePanel.querySelectorAll<HTMLElement>('.explorer-module').forEach(mod => {
            mod.style.animation = 'none';
            mod.offsetHeight; // force reflow
            mod.style.animation = '';
          });
        }
      });
    });
  });
</script>
