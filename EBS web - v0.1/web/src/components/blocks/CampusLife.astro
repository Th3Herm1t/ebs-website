---
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';

const photos = [
  { src: '/images/campus/students-3.jpg', alt: isFr ? 'Vie étudiante au campus EBS' : 'Student life at EBS campus', span: 'col-span-2 row-span-2' },
  { src: '/images/events/conference.jpg', alt: isFr ? 'Conférence à EBS' : 'Conference at EBS', span: '' },
  { src: '/images/campus/students-5.jpg', alt: isFr ? 'Étudiants en cours' : 'Students in class', span: '' },
  { src: '/images/events/ebs-challenge.jpg', alt: 'EBS Challenge', span: '' },
  { src: '/images/events/salon-riyeda.jpg', alt: isFr ? 'EBS au Salon Riyeda' : 'EBS at Salon Riyeda', span: '' },
  { src: '/images/campus/students-8.jpg', alt: isFr ? 'Journée portes ouvertes' : 'Open day', span: 'col-span-2' },
  { src: '/images/events/seminaire.jpg', alt: isFr ? 'Séminaire professionnel' : 'Professional seminar', span: '' },
  { src: '/images/events/excelia.jpg', alt: isFr ? 'Partenariat Excelia' : 'Excelia partnership', span: '' },
];
---

<section id="campus-life" class="py-20 lg:py-28 bg-surface-alt overflow-hidden" aria-labelledby="campus-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">

    {/* Header */}
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
      <div class="max-w-xl">
        <span class="text-xs font-bold text-accent uppercase tracking-wider mb-3 block">{isFr ? 'La vie à EBS' : 'Life at EBS'}</span>
        <h2 id="campus-heading" class="font-heading font-bold text-h2 text-ink mb-4">
          {isFr ? "Plus qu'une université" : 'More than a university'}<span class="text-accent">.</span>
        </h2>
        <p class="font-body text-ink-body text-body-lg leading-relaxed">
          {isFr ? 'Conférences, séminaires, événements sportifs, sorties culturelles — la vie étudiante à EBS dépasse les salles de cours.' : 'Conferences, seminars, sports events, cultural outings — student life at EBS goes beyond the classroom.'}
        </p>
      </div>
      <a href={isFr ? '/a-propos' : '/en/about'} class="inline-flex items-center text-sm font-semibold text-navy hover:text-accent transition-colors gap-1 hover:gap-2 shrink-0 pb-2">
        {isFr ? 'Découvrir le campus' : 'Discover the campus'} <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* Photo Mosaic Grid */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 auto-rows-[180px] md:auto-rows-[200px]">
      {photos.map((photo, i) => (
        <div
          class={`mosaic-item group relative overflow-hidden ${photo.span} reveal`}
          style={`--delay: ${i * 80}ms`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-navy/0 group-hover:bg-navy/40 transition-colors duration-300"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <span class="text-white text-sm font-medium">{photo.alt}</span>
          </div>
        </div>
      ))}
    </div>

    {/* Stats bar below gallery */}
    <div class="grid grid-cols-3 gap-px mt-8 bg-border/30">
      <div class="bg-surface p-6 text-center reveal" style="--delay: 0ms">
        <span class="font-heading font-bold text-2xl md:text-3xl text-accent block" data-countup="10" data-suffix="+">0</span>
        <span class="text-sm text-ink-muted font-medium">{isFr ? 'événements par an' : 'events per year'}</span>
      </div>
      <div class="bg-surface p-6 text-center reveal" style="--delay: 60ms">
        <span class="font-heading font-bold text-2xl md:text-3xl text-accent block" data-countup="50" data-suffix="+">0</span>
        <span class="text-sm text-ink-muted font-medium">{isFr ? 'entreprises visitées' : 'companies visited'}</span>
      </div>
      <div class="bg-surface p-6 text-center reveal" style="--delay: 120ms">
        <span class="font-heading font-bold text-2xl md:text-3xl text-accent block" data-countup="8">0</span>
        <span class="text-sm text-ink-muted font-medium">{isFr ? 'clubs étudiants' : 'student clubs'}</span>
      </div>
    </div>

  </div>
</section>
