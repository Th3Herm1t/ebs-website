---
import Button from '../ui/Button.astro';
import AccentBar from '../ui/AccentBar.astro';
import { ui, switchLocalePath, type Locale } from '../../lib/i18n';

interface Props { lang?: Locale; }
const { lang = 'fr' } = Astro.props;
const t = ui[lang];
const currentPath = Astro.url.pathname;
const frPath = lang === 'fr' ? currentPath : switchLocalePath(currentPath, 'fr');
const enPath = lang === 'en' ? currentPath : switchLocalePath(currentPath, 'en');
---

<footer class="bg-navy text-base-300 w-full pt-16 pb-8" aria-label={lang === 'fr' ? 'Navigation de pied de page' : 'Footer navigation'}>
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
    {/* Col 1 */}
    <div class="flex flex-col">
      <img
        src="/images/logos/ebs-logo.png"
        alt="EBS — Espima Business School"
        width="320"
        height="73"
        class="w-full max-w-[160px] object-contain mb-8"
      />
      <p class="text-small text-base-500 leading-relaxed max-w-xs mb-6">
        {t.tagline}
      </p>
      <div class="flex items-center space-x-4">
        <a href="https://facebook.com/ebstunis" class="text-base-400 hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://instagram.com/ebstunis" class="text-base-400 hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a href="https://linkedin.com/school/ebstunis" class="text-base-400 hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      </div>
    </div>

    {/* Col 2 */}
    <div class="flex flex-col">
      <h3 class="font-heading font-semibold text-surface text-lg mb-6">{t.programmes}</h3>
      <ul class="space-y-3">
        <li><a href={`${t.programmesHref}/licence-informatique-genie-logiciel`} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.footerLicenceInfo}</a></li>
        <li><a href={`${t.programmesHref}/licence-management`} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.footerLicenceMgmt}</a></li>
        <li><a href={`${t.programmesHref}/master-marketing-digital-ia`} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.footerMasterMktg}</a></li>
        <li><a href={`${t.programmesHref}/master-transformation-digitale-crm`} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.footerMasterCRM}</a></li>
        <li><a href={t.programmesHref} class="text-small text-accent font-medium mt-2 flex items-center hover:text-accent-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">
          {t.viewAllProgrammes} <svg class="ml-1 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a></li>
      </ul>
    </div>

    {/* Col 3 */}
    <div class="flex flex-col">
      <h3 class="font-heading font-semibold text-surface text-lg mb-6">{t.resources}</h3>
      <ul class="space-y-3">
        <li><a href={lang === 'fr' ? '/certifications' : '/en/certifications'} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.certCatalog}</a></li>
        <li><a href={lang === 'fr' ? '/international' : '/en/international'} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.intlPathways}</a></li>
        <li><a href={t.alternanceHref} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.workStudyModel}</a></li>
        <li><a href={t.admissionsHref} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.admissionsGuide}</a></li>
        <li><a href={t.brochuresHref} class="text-small hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.brochures}</a></li>
      </ul>
    </div>

    {/* Col 4 */}
    <div class="flex flex-col">
      <h3 class="font-heading font-semibold text-surface text-lg mb-6">{t.contact}</h3>
      <ul class="space-y-3 text-small">
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-3 text-base-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href="tel:+21629582835" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">+216 29 58 28 35</a>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-3 text-base-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <a href="mailto:admission@ebs.tn" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">admission@ebs.tn</a>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-3 text-base-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>{t.address}</span>
        </li>
        <li class="mt-4 pt-2">
          <a href="https://wa.me/21629582835" class="inline-flex items-center text-small font-medium text-surface hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">
            <svg class="w-5 h-5 mr-2 text-[#25D366]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path></svg>
            {t.whatsappChat}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <AccentBar height="sm" class="opacity-10" />

  <div class="max-w-7xl mx-auto px-6 mt-8 flex flex-col md:flex-row items-center justify-between text-micro text-base-500 space-y-4 md:space-y-0">
    <div>
      © {new Date().getFullYear()} EBS Tunis. {t.allRightsReserved}
    </div>
    <div class="flex items-center space-x-6">
      <a href={t.legalNoticeHref} class="hover:text-surface transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.legalNotice}</a>
      <a href={t.privacyPolicyHref} class="hover:text-surface transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">{t.privacyPolicy}</a>
      <div class="flex items-center space-x-2 pl-4 border-l border-white/15">
        {lang === 'fr' ? (
          <><span class="text-surface font-bold">FR</span><span>/</span><a href={enPath} class="hover:text-surface transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">EN</a></>
        ) : (
          <><a href={frPath} class="hover:text-surface transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm">FR</a><span>/</span><span class="text-surface font-bold">EN</span></>
        )}
      </div>
    </div>
  </div>
</footer>
