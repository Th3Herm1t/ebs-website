---
/**
 * VideoTour.astro — Full-width video campus tour section
 * Shows a poster image with a play button overlay.
 * Clicking the button replaces the poster with an autoplay iframe.
 * @prop lang - 'fr' | 'en'
 */
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;

const t = {
  fr: {
    kicker: 'Visite virtuelle',
    title: 'Découvrez notre campus',
    desc: 'Explorez les espaces d\'apprentissage, les labs et la vie étudiante à EBS Tunis.',
    play: 'Lancer la visite',
  },
  en: {
    kicker: 'Virtual tour',
    title: 'Discover our campus',
    desc: 'Explore learning spaces, labs and student life at EBS Tunis.',
    play: 'Start the tour',
  },
}[lang];
---

<section class="relative overflow-hidden bg-navy" aria-label={t.title}>
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 py-20 lg:py-28">
    <div class="text-center mb-10 reveal">
      <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-3">{t.kicker}</p>
      <h2 class="font-heading font-bold text-h2 text-white leading-tight mb-3">{t.title}</h2>
      <p class="font-body text-white/60 text-base max-w-xl mx-auto">{t.desc}</p>
    </div>

    <div id="video-tour-container" class="relative aspect-video max-w-4xl mx-auto overflow-hidden group cursor-pointer reveal" style="--delay:100ms">
      {/* Poster */}
      <img
        id="video-tour-poster"
        src="/images/campus/campus-2.jpg"
        alt={t.title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-navy/40 group-hover:bg-navy/30 transition-colors"></div>

      {/* Play button */}
      <button
        id="video-tour-play"
        type="button"
        aria-label={t.play}
        class="absolute inset-0 flex flex-col items-center justify-center z-10"
      >
        <span class="w-20 h-20 bg-accent flex items-center justify-center rounded-full shadow-xl shadow-accent/30 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-base-950 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="mt-4 text-sm font-semibold text-white/80 uppercase tracking-wider">{t.play}</span>
      </button>

      {/* Iframe placeholder — inserted by JS */}
      <div id="video-tour-frame" class="absolute inset-0 hidden"></div>
    </div>

    {/* Campus highlights strip */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 max-w-4xl mx-auto reveal" style="--delay:200ms">
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-3">
        <span class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0"><svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0H5m14 0h2m-16 0H3" /><path d="M9 7h1m-1 4h1m4-4h1m-1 4h1" /></svg></span>
        <span class="text-sm text-white/80 font-medium">{lang === 'fr' ? 'Campus moderne' : 'Modern campus'}</span>
      </div>
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-3">
        <span class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0"><svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8m-4-4v4" /></svg></span>
        <span class="text-sm text-white/80 font-medium">{lang === 'fr' ? 'Labs équipés' : 'Equipped labs'}</span>
      </div>
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-3">
        <span class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0"><svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg></span>
        <span class="text-sm text-white/80 font-medium">{lang === 'fr' ? 'Bibliothèque' : 'Library'}</span>
      </div>
      <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-3">
        <span class="w-8 h-8 bg-accent/10 flex items-center justify-center shrink-0"><svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 8h1a4 4 0 1 1 0 8h-1" /><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" /><line x1="6" x2="6" y1="2" y2="4" /><line x1="10" x2="10" y1="2" y2="4" /><line x1="14" x2="14" y1="2" y2="4" /></svg></span>
        <span class="text-sm text-white/80 font-medium">{lang === 'fr' ? 'Espace détente' : 'Lounge area'}</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('video-tour-container');
    const playBtn = document.getElementById('video-tour-play');
    const poster = document.getElementById('video-tour-poster');
    const frame = document.getElementById('video-tour-frame');
    if (!container || !playBtn || !frame) return;

    playBtn.addEventListener('click', () => {
      // Replace with embedded video — using a placeholder campus tour video
      // In production, replace this src with the actual EBS campus tour video URL
      frame.innerHTML = `<iframe
        src="https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&rel=0&modestbranding=1"
        title="EBS Campus Tour"
        class="w-full h-full"
        frameborder="0"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>`;
      frame.classList.remove('hidden');
      playBtn.classList.add('hidden');
      if (poster) poster.classList.add('hidden');
    });
  });
</script>
