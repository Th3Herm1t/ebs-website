---
import Marker from '../ui/Marker.astro';
import { getLocaleFromPath } from '@/lib/i18n';
const isFr = getLocaleFromPath(Astro.url.pathname) === 'fr';
---

<section id="cta" class="relative overflow-hidden cta-frame" aria-label={isFr ? 'Préinscription' : 'Pre-registration'}>
  {/* Background image */}
  <div class="absolute inset-0 z-0">
    <img src="/images/campus/students-9.jpg" alt="" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-accent/90"></div>
  </div>

  <div class="relative z-10 py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6 md:px-12 text-center flex flex-col items-center">
      <h2 class="font-heading font-bold text-h2 md:text-[3rem] text-base-950 leading-tight mb-4">
        {isFr ? 'Prêt à commencer ?' : 'Ready to start?'}
      </h2>

      <p class="font-body text-lg md:text-xl text-base-900 font-medium mb-2">
        {isFr ? '3 minutes. 4 étapes.' : '3 minutes. 4 steps.'}
      </p>

      <p class="font-heading font-semibold text-base-950 text-lg mb-10 flex items-center gap-2 justify-center">
        {isFr ? 'Ta place est déjà réservée' : 'Your spot is already reserved'} <Marker size="sm" />
      </p>

      <a
        href={isFr ? '/preinscription' : '/en/pre-registration'}
        class="inline-flex items-center justify-center bg-white text-base-950 font-heading font-bold text-lg px-10 py-4 hover:bg-base-100 transition-colors mb-8 gap-2 shadow-xl shadow-black/10"
      >
        {isFr ? 'Commencer ma préinscription' : 'Start my pre-registration'} <span aria-hidden="true">→</span>
      </a>

      <p class="text-sm text-base-800 mb-4">{isFr ? '— ou —' : '— or —'}</p>
      <div class="flex flex-col sm:flex-row items-center gap-4 text-sm font-medium text-base-900">
        <a href="tel:+21629582835" class="hover:text-base-950 transition-colors">
          +216 29 58 28 35
        </a>
        <span class="hidden sm:inline text-base-700" aria-hidden="true">·</span>
        <a href="https://wa.me/21629582835" target="_blank" rel="noopener noreferrer" class="hover:text-base-950 transition-colors">
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-frame {
    border: 3px solid rgba(255,255,255,0.25);
    border-top-right-radius: 0;
    clip-path: polygon(0 0, calc(100% - 48px) 0, 100% 48px, 100% 100%, 0 100%);
  }
</style>
