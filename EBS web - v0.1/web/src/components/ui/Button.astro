---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverted';
  size?: 'base' | 'sm' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'base', class: className, ...props } = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-heading font-semibold outline-none transition-all duration-200 active:scale-97 disabled:opacity-50 disabled:pointer-events-none ring-offset-base focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2";

const variants = {
  primary: "bg-accent text-text-on-accent hover:bg-accent-hover",
  secondary: "border-2 border-navy text-navy hover:bg-navy hover:text-base-50",
  inverted: "bg-surface text-ink hover:bg-surface-alt",
  ghost: "bg-transparent text-navy hover:text-accent",
};

const sizes = {
  sm: "h-9 px-4 text-small",
  base: "h-12 px-6 text-body",
  lg: "h-14 px-8 text-body lg:text-h4",
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...(props as any)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...props}>
      <slot />
    </button>
  )
}
