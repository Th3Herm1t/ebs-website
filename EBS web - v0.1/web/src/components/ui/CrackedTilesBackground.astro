---
interface Props {
  baseColor?: string;
  glowColor?: string;
  tileSize?: number;
  glowOpacity?: number;
  class?: string;
}

const {
  baseColor = '#063966',
  glowColor = '#FF6D00',
  tileSize = 28,
  glowOpacity = 0.30,
  class: className = '',
} = Astro.props;
---

<div class={`tile-bg-container absolute inset-0 z-0 overflow-hidden ${className}`}>
  <canvas 
    class="absolute inset-0 block w-full h-full" 
    data-tile-bg 
    data-base-color={baseColor}
    data-glow-color={glowColor}
    data-tile-size={tileSize}
    data-glow-opacity={glowOpacity}
    aria-hidden="true"
  ></canvas>
</div>

<script>
  // @ts-nocheck
  class TileBg {
    constructor(canvas) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d', { alpha: false });
      this.baseColor = canvas.dataset.baseColor;
      this.glowColor = canvas.dataset.glowColor;
      this.tileSize = parseInt(canvas.dataset.tileSize, 10);
      this.glowOpacity = parseFloat(canvas.dataset.glowOpacity);

      this.width = 0;
      this.height = 0;
      this.tiles = [];
      this.mouse = { x: -1000, y: -1000, radius: 180 };
      this.needsRender = true;
      this.isIdle = true;

      this.init();
      this.bindEvents();
      this.drawStatic();
    }

    init() {
      const dpr = window.devicePixelRatio || 1;
      const rect = this.canvas.parentElement.getBoundingClientRect();
      
      this.width = rect.width;
      this.height = rect.height;
      
      this.canvas.width = this.width * dpr;
      this.canvas.height = this.height * dpr;
      this.ctx.scale(dpr, dpr);
      
      const cols = Math.ceil(this.width / this.tileSize) + 2;
      const rows = Math.ceil(this.height / this.tileSize) + 2;
      
      this.tiles = [];
      for (let y = -1; y < rows; y++) {
        for (let x = -1; x < cols; x++) {
          this.tiles.push({
            cx: (x * this.tileSize) + (this.tileSize / 2),
            cy: (y * this.tileSize) + (this.tileSize / 2),
            scale: 1,
          });
        }
      }

      this.glowFill = this.glowColor;
    }

    drawStatic() {
      this.ctx.fillStyle = this.baseColor;
      this.ctx.fillRect(0, 0, this.width, this.height);
    }

    bindEvents() {
      this.resizeHandler = () => { this.init(); this.drawStatic(); };
      window.addEventListener('resize', this.resizeHandler);

      this.eventTarget = this.canvas.closest('section') || this.canvas.parentElement.parentElement;

      this.mouseMoveHandler = (e) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouse.x = e.clientX - rect.left;
        this.mouse.y = e.clientY - rect.top;
        
        if (this.isIdle) {
          this.isIdle = false;
          this.animate = this.animate.bind(this);
          requestAnimationFrame(this.animate);
        }
      };

      this.mouseLeaveHandler = () => {
        this.mouse.x = -1000;
        this.mouse.y = -1000;
      };

      this.eventTarget.addEventListener('mousemove', this.mouseMoveHandler);
      this.eventTarget.addEventListener('mouseleave', this.mouseLeaveHandler);
    }

    destroy() {
      window.removeEventListener('resize', this.resizeHandler);
      if (this.eventTarget) {
        this.eventTarget.removeEventListener('mousemove', this.mouseMoveHandler);
        this.eventTarget.removeEventListener('mouseleave', this.mouseLeaveHandler);
      }
      this.isIdle = true;
    }

    animate() {
      if (this.isIdle) return;

      this.ctx.fillStyle = this.baseColor;
      this.ctx.fillRect(0, 0, this.width, this.height);

      this.ctx.globalAlpha = this.glowOpacity;
      this.ctx.fillStyle = this.glowFill;
      this.ctx.fillRect(0, 0, this.width, this.height);
      this.ctx.globalAlpha = 1.0;

      this.ctx.fillStyle = this.baseColor;

      let allSettled = true;

      for (let i = 0; i < this.tiles.length; i++) {
        const tile = this.tiles[i];
        let targetScale = 1.0;

        const dx = tile.cx - this.mouse.x;
        const dy = tile.cy - this.mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        if (dist < this.mouse.radius) {
          const intensity = 1 - (dist / this.mouse.radius);
          const ease = Math.sin(intensity * Math.PI / 2);
          targetScale = 1.0 - (ease * 0.18);
        }

        const diff = targetScale - tile.scale;
        if (Math.abs(diff) > 0.0005) {
          tile.scale += diff * 0.12;
          allSettled = false;
        } else {
          tile.scale = targetScale;
        }

        const drawScale = tile.scale > 0.998 ? 1 : tile.scale;
        const size = this.tileSize * drawScale;
        const px = tile.cx - (size / 2);
        const py = tile.cy - (size / 2);

        const offset = drawScale === 1 ? 0.5 : 0;
        this.ctx.fillRect(px - offset, py - offset, size + (offset * 2), size + (offset * 2));
      }

      if (allSettled && this.mouse.x < -500) {
        this.isIdle = true;
        this.drawStatic();
        return;
      }

      requestAnimationFrame(this.animate);
    }
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-tile-bg]').forEach(canvas => {
      if (!canvas.tileBgInstance) {
        canvas.tileBgInstance = new TileBg(canvas);
      }
    });
  });

  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll('[data-tile-bg]').forEach(canvas => {
      if (canvas.tileBgInstance) {
        canvas.tileBgInstance.destroy();
        canvas.tileBgInstance = null;
      }
    });
  });
</script>
