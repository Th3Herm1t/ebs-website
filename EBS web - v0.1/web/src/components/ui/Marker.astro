---
interface Props {
  class?: string;
  size?: 'sm' | 'base' | 'lg';
  rotation?: '0' | '45';
}

const { class: className, size = 'base', rotation = '0' } = Astro.props;

const sizes = {
  sm: "w-1.5 h-1.5",
  base: "w-2.5 h-2.5",
  lg: "w-4 h-4"
};

const rotations = {
  '0': "",
  '45': "rotate-45"
};

const classes = ["bg-accent shrink-0", sizes[size], rotations[rotation], className].filter(Boolean).join(' ');
---

<div class={classes} aria-hidden="true"></div>
